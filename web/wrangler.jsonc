{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "penelope-social",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  // No `nodejs_compat`: it existed only for `mimetext`, which the old Email
  // Routing send path needed to build a MIME message by hand. Email Service
  // takes a plain object, so both are gone.

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",

    // The Webflow site served every URL without a trailing slash and Astro is
    // built the same way (`trailingSlash: 'never'`). Cloudflare's default
    // ("auto-trailing-slash") disagrees: it 307s /menus -> /menus/, which adds
    // a redirect hop to every internal link and changes the canonical URL of
    // all 14 pages. "drop-trailing-slash" serves /menus straight from
    // /menus/index.html and redirects the slashed form instead.
    "html_handling": "drop-trailing-slash",

    // Only the form endpoints hit the Worker; everything else is a static hit.
    "run_worker_first": ["/api/*"]
  },

  // Newsletter signups. Penelope's own database — Arti runs the same code
  // against `arti-ristorante-subscribers`, and the two never share a row.
  "d1_databases": [
    {
      "binding": "SUBSCRIBERS",
      "database_name": "penelope-social-subscribers",
      "database_id": "fff4209a-ecc0-4181-801b-b937373a17f9",
      // Per-binding, not top-level: wrangler warns "unexpected field" on the
      // latter and then ignores it, so a schema change would apply from
      // wrangler's default directory rather than this one.
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  },

  // Contact + events notifications. Cloudflare Email Service, via the binding.
  //
  // No restriction attribute on the binding: `destination_address` would pin it
  // to one address, and the destination is expected to move to the client's own
  // inbox once penelopesocial.com is onboarded. The binding can only reach
  // verified destination addresses on the account either way.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "EMAIL_PROVIDER": "cloudflare",

    // Going to Web Disco for now — it is the only verified destination address
    // on the account. Switch to the client's inbox at cutover.
    "NOTIFY_EMAIL_TO": "hello@webdisco.digital",

    // NOT YET DELIVERABLE. The sender address must belong to a domain onboarded
    // to Email Service, and neither penelopesocial.com nor webdisco.digital is
    // — every send currently fails with `email.sending.error.email.invalid`.
    // Submissions still succeed for the visitor and the full payload is written
    // to the Worker log (see worker/index.ts). Onboard the domain that matches
    // this address to finish the wiring:
    //   npx wrangler email sending enable penelopesocial.com
    "NOTIFY_EMAIL_FROM": "website@penelopesocial.com"
  }

  // Secrets are set with `wrangler secret put`, never committed:
  //   TURNSTILE_SECRET_KEY
  //   SUBSCRIBERS_USER       (Basic Auth user for /api/subscribers.csv)
  //   SUBSCRIBERS_PASSWORD   (Basic Auth password for the same)
  //   RESEND_API_KEY         (only if EMAIL_PROVIDER is switched to "resend")
}
