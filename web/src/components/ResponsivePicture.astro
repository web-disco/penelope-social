---
/**
 * Responsive WebP <picture> for every content photo, generated by Astro at
 * build time from src/assets/images/. Callers pass the slot's `sizes`; the
 * browser picks the smallest width that fills it.
 *
 * Widths: the standard set up to the original's width (never upscaled), plus
 * the original width itself. The fallback <img> is JPEG (PNG for a PNG
 * source) for the rare browser without WebP.
 *
 * The <picture> is `display: contents` unless a class is passed, so the <img>
 * lays out exactly as it did when it was a direct child: same flex item, same
 * absolute positioning, same aspect-ratio box. The <img> gets the original's
 * real width/height (correct aspect ratio before CSS loads); CSS sets the
 * displayed size.
 *
 * Anything else passed (data-*, title, style) lands on the <img>.
 */
import { Picture } from 'astro:assets'
import type { Image } from '../lib/content'

interface Props {
  image: Image
  sizes: string
  /** Alt text override. Defaults to the image's own alt. */
  alt?: string
  class?: string
  imgClass?: string
  style?: string
  loading?: 'eager' | 'lazy'
  fetchpriority?: 'high' | 'low' | 'auto'
  decoding?: 'async' | 'sync' | 'auto'
  draggable?: boolean
  /** WebP quality. 78 for photos. */
  quality?: number
  [attr: `data-${string}`]: string | undefined
  title?: string
}

const {
  image,
  sizes,
  alt,
  class: className = 'contents',
  imgClass,
  style,
  loading = 'lazy',
  fetchpriority,
  decoding,
  draggable,
  quality = 78,
  ...rest
} = Astro.props

const WIDTHS = [480, 640, 768, 1024, 1280, 1600, 1920, 2400]
const asset = image.src
const widths = [...new Set([...WIDTHS.filter((w) => w < asset.width), Math.min(asset.width, 2400)])]
const fallbackFormat = asset.format === 'png' ? 'png' : 'jpg'
const position = image.objectPosition ? `object-position: ${image.objectPosition};` : undefined
---

<Picture
  src={asset}
  alt={alt ?? image.alt}
  formats={['webp']}
  fallbackFormat={fallbackFormat}
  widths={widths}
  sizes={sizes}
  quality={quality}
  pictureAttributes={{ class: className }}
  class={imgClass}
  style={[position, style].filter(Boolean).join(' ') || undefined}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding={decoding}
  draggable={draggable === false ? 'false' : undefined}
  {...rest}
/>
