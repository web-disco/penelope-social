---
/**
 * Menu category blocks. Bakehouse rhythm: title, short blurb, hairline, items.
 * “Currently unavailable” lines stay as small body copy, not category-sized headings.
 */
import { container, typeScale } from '../lib/ui'
import LineText from './LineText.astro'

interface Props {
  categories: any[]
}
const { categories } = Astro.props

const isUnavailable = (item: any) => /unavailable/i.test(item?.title ?? '')
---

{
  categories.map((category) => (
    <div id={category.anchor?.current} class="menu-category">
      <div class={container}>
        <h2
          class:list={[
            'page-sub-heading mt-0 mb-0 overflow-hidden text-charcoal',
            typeScale.displayS,
          ]}
        >
          {category.title}
        </h2>
        {category.description && (
          <p class:list={['menu-description mt-space-8 mb-space-16 text-charcoal', typeScale.body]}>
            <LineText text={category.description} />
          </p>
        )}
        <div class="menu-category-wrapper w-dyn-list">
          {category.items?.length ? (
            <div
              role="list"
              class="menu-category-list grid auto-cols-[1fr] grid-cols-3 grid-rows-[auto] gap-x-[60px] gap-y-space-24 wf-md:grid-cols-2 wf-md:gap-x-10 wf-sm:grid-cols-1 wf-xs:gap-x-5"
            >
              {category.items.map((item: any) =>
                isUnavailable(item) ? (
                  <div role="listitem" class="menu-category-item border-t-2 border-charcoal">
                    <p class:list={['mt-space-16 mb-0 text-charcoal', typeScale.body]}>
                      {item.title}
                    </p>
                  </div>
                ) : (
                  <div role="listitem" class="menu-category-item border-t-2 border-charcoal">
                    <div class="menu-item-heading mt-space-16 flex items-start justify-between gap-10 pb-space-8 wf-sm:gap-5">
                      <h3
                        class:list={[
                          'menu-item-title mt-0 mb-0 text-charcoal',
                          typeScale.heading,
                        ]}
                      >
                        {item.title}
                      </h3>
                      {item.price && (
                        <p class:list={['heading-menu-price mt-0 mb-0 text-charcoal', typeScale.heading]}>
                          {item.price}
                        </p>
                      )}
                    </div>
                    {item.description && (
                      <div class="menu-item-description">
                        <p class:list={['mb-0 text-charcoal', typeScale.body]}>{item.description}</p>
                      </div>
                    )}
                  </div>
                )
              )}
            </div>
          ) : (
            <div class="w-dyn-empty">
              <div>No items found.</div>
            </div>
          )}
        </div>
      </div>
    </div>
  ))
}
