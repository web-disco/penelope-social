---
/**
 * Menu category blocks. Bakehouse /menu type and spacing:
 * 40px category title, one-line blurb, 60px grid, 24px item / price.
 * An empty list stays titled, with a "nothing right now" line.
 */
import { layout, typeScale } from '../lib/ui'
import { offerFor, paragraphsHtml, type MenuItemOffer } from '../lib/content'

interface Props {
  categories: { title: string; anchor: string; description?: string; items: { title: string; description?: string; price?: string }[] }[]
  /** After a banner that already has mb-section-gap-y. False when another cream block sits above. */
  flushTop?: boolean
  /** Dishes another menu borrows (Happy Hour), by name: each gets a link to it. */
  offers?: Map<string, MenuItemOffer>
}
const { categories, flushTop = true, offers } = Astro.props

function splitTitleSize(title: string) {
  const match = title.match(/^(.*?)(\s*\([^)]+\))$/)
  if (!match) return { name: title, suffix: '' }
  return { name: match[1], suffix: match[2] }
}

function isMultiPrice(price?: string) {
  return Boolean(price && /[|/]/.test(String(price)))
}
---

{
  categories.map((category, index) => {
    const blurb = category.description ? paragraphsHtml(category.description) : ''
    const items = category.items
    return (
      <section
        id={category.anchor}
        class:list={[
          'menu-category',
          index === 0
            ? flushTop
              ? 'mt-0'
              : 'mt-section-pad wf-sm:mt-section-pad-sm'
            : 'mt-section-gap-y mb-0 wf-sm:mt-section-gap-y-sm',
        ]}
      >
        <div class={layout.shell}>
          <h2 class:list={['page-sub-heading mt-0 mb-space-12 text-charcoal', typeScale.displayL]}>
            {category.title}
          </h2>
          {blurb && (
            <div
              class:list={[
                'menu-description mb-space-24 text-charcoal [&_p]:my-0',
                '[&_a]:text-charcoal [&_a]:underline [&_a]:underline-offset-[0.18em] [&_a]:decoration-charcoal/40',
                '[&_a]:transition-opacity [&_a]:duration-[350ms] hover:[&_a]:opacity-70 [&_strong]:font-medium',
                typeScale.bodyLg,
              ]}
              set:html={blurb}
            />
          )}
          {items.length ? (
            <div class="menu-category-wrapper w-dyn-list">
              <div
                role="list"
                class="menu-category-list grid auto-cols-[1fr] grid-cols-3 grid-rows-[auto] gap-[60px] wf-md:grid-cols-2 wf-md:gap-10 wf-sm:grid-cols-1 wf-xs:gap-5"
              >
                {items.map((item) => {
                  const { name, suffix } = splitTitleSize(item.title)
                  const offer = offers && offerFor(offers, item.title)
                  const multi = isMultiPrice(item.price)
                  return (
                    <div role="listitem" class="menu-category-item border-t-2 border-charcoal">
                      <div class="menu-item-heading mt-5 mb-0 flex items-start justify-between pb-5 gap-space-16">
                        {/* font-body is load-bearing: webflow-base sets body to
                            Arial, so every element that does not name a family
                            inherits it. Each token in lib/ui.ts carries font-body
                            for that reason; this heading was hand-rolled and did
                            not, which put every menu item name in Arial while the
                            category heading beside it rendered in Sweet Sans. */}
                        <h3 class="menu-item-title mt-0 mb-0 font-body text-[24px] font-medium leading-[120%] text-pretty text-charcoal wf-sm:text-[20px] wf-xs:text-[18px]">
                          {name}
                          {suffix && <span class="whitespace-nowrap">{suffix}</span>}
                        </h3>
                        {item.price && (
                          <p
                            class:list={[
                              'heading-menu-price mt-0 mb-0 whitespace-nowrap text-charcoal',
                              /* Same steps as the item name, so name and price stay on one line. */
                              multi ? 'text-[16px] leading-[150%] wf-xs:text-[14px]' : 'text-[24px] leading-[120%] wf-sm:text-[20px] wf-xs:text-[18px]',
                            ]}
                          >
                            {item.price}
                          </p>
                        )}
                      </div>
                      {item.description && (
                        <div class="menu-item-description">
                          <p class:list={['mb-0 text-charcoal', typeScale.body]}>{item.description}</p>
                        </div>
                      )}
                      {offer && (
                        <a
                          href={offer.url}
                          class:list={[
                            'menu-item-offer mt-space-16 inline-flex items-center gap-space-8 text-green no-underline',
                            'transition-opacity duration-[350ms] hover:opacity-70',
                            typeScale.label,
                          ]}
                        >
                          <span>
                            {offer.label} · {offer.price}
                          </span>
                          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" stroke="currentColor" stroke-width="1.5" />
                          </svg>
                        </a>
                      )}
                    </div>
                  )
                })}
              </div>
            </div>
          ) : (
            <p class:list={['menu-empty mt-0 mb-0 text-charcoal', typeScale.body]}>
              Nothing on this list right now.
            </p>
          )}
        </div>
      </section>
    )
  })
}
