---
/**
 * Navbar — inline links + CTAs on wide screens; hamburger drawer below 1536px.
 * Drawer open/close, spacing, type, and close-on-the-right match Bakehouse.
 * Social keeps two CTAs (Order / Reservations) and Merch in the drawer.
 */
import { btn, heading, layout } from '../lib/ui'
import { imageUrl } from '../lib/image'
import { isMerchNav, resolveNavLinks } from '../data/nav'

interface Props {
  settings: any
  isHome?: boolean
  solidNav?: boolean
}
const { settings, isHome = false, solidNav = false } = Astro.props

const header = settings.header ?? {}
const socials = settings.footer?.contact?.socials ?? []
const logoSrc = imageUrl(header.logo) || '/penelope-logo.svg'

const navLinks = resolveNavLinks(header.drawerLinks)
const desktopNavLinks = navLinks.filter((link) => !isMerchNav(link))

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const currentHash = Astro.url.hash

const isCurrent = (url: string) => {
  if (/^https?:\/\//i.test(url)) return false
  const [path, hash = ''] = url.split('#')
  const normalizedPath = path.replace(/\/$/, '') || '/'

  if (hash) {
    return pathname === normalizedPath && currentHash === `#${hash}`
  }

  if (normalizedPath === '/') return pathname === '/'
  return pathname === normalizedPath || pathname.startsWith(`${normalizedPath}/`)
}

const linkClass =
  'nav-link whitespace-nowrap text-beige no-underline font-body font-medium uppercase ' +
  'text-[13px] tracking-[0.08em] leading-[1.4] transition-opacity duration-[350ms] hover:opacity-70'

const navScrolled = solidNav

function gaEventForNav(url: string) {
  if (url.includes('egiftcards')) return 'gift_card_click'
  if (url === '/catering-events') return 'catering_click'
  if (url === '/merchandise') return 'merch_click'
  return undefined
}
---

<div
  class:list={[
    /* --announcement-top: where the announcement bar ends (AnnouncementBar.astro). */
    'navbar fixed inset-x-0 top-[var(--announcement-top,0px)] bottom-auto z-20 w-full',
    'transition-[background-color] duration-300 ease-out',
    navScrolled && 'is-scrolled',
  ]}
  data-navbar
  data-nav-scroll={solidNav ? 'false' : 'true'}
>
  <div
    class:list={[
      'navbar-wrap navbar__bar relative flex items-stretch justify-between',
      layout.navShell,
    ]}
  >
    <nav class="navbar__links" aria-label="Primary">
      {
        desktopNavLinks.map((link) => (
          <a
            href={link.url}
            target={link.newTab ? '_blank' : undefined}
            rel={link.newTab ? 'noopener noreferrer' : undefined}
            data-ga-event={gaEventForNav(link.url)}
            class={linkClass}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="navbar__actions flex items-center gap-3">
      {
        header.orderOnline?.url && (
          <a
            href={header.orderOnline.url}
            target={header.orderOnline.newTab ? '_blank' : undefined}
            rel={header.orderOnline.newTab ? 'noopener noreferrer' : undefined}
            data-ga-event="order_click"
            data-ga-placement="nav"
            class:list={[btn.navSolid, 'navbar__cta']}
          >
            <span>{header.orderOnline.label}</span>
          </a>
        )
      }
      {
        header.reservations?.url && (
          <a
            href={header.reservations.url}
            target={header.reservations.newTab ? '_blank' : undefined}
            rel={header.reservations.newTab ? 'noopener noreferrer' : undefined}
            data-ga-event="reservation_click"
            class:list={[btn.navOutline, 'navbar__cta']}
          >
            <span>
              {header.reservations.label === 'reservations' ? 'Reservations' : header.reservations.label}
            </span>
          </a>
        )
      }
    </div>

    <button
      class="navbar__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-drawer"
      aria-label="Open menu"
    >
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
    </button>
  </div>

  <a
    href="/"
    aria-current={isHome ? 'page' : undefined}
    class:list={[
      'navbar-logo-link navbar__logo pointer-events-auto absolute left-1/2 top-1/2 z-[70] flex -translate-x-1/2 -translate-y-1/2 flex-col items-center no-underline',
      isHome && 'w--current',
    ]}
  >
    <img
      src={logoSrc}
      loading="eager"
      alt={header.logoAlt ?? 'Penelope Logo'}
      class="navbar-logo block w-[128px] wf-md:w-[110px] wf-xs:w-[84px]"
    />
    <span
      aria-hidden="true"
      class="navbar-logo-sub mt-space-8 font-body font-medium uppercase leading-none tracking-[0.32em] text-beige text-[10px] wf-md:text-[9px] wf-xs:mt-space-4 wf-xs:text-[7px] wf-xs:tracking-[0.26em]"
    >
      Social
    </span>
  </a>
</div>

<div
  id="menu-drawer"
  class="menu-drawer"
  data-lenis-prevent
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  hidden
>
  <div class:list={['menu-drawer__bar', layout.shell]}>
    <button class="menu-drawer__close" type="button" aria-label="Close menu">
      <span class="menu-drawer__close-bar"></span>
      <span class="menu-drawer__close-bar"></span>
    </button>
  </div>

  <nav class:list={['menu-drawer__links', layout.shell]} aria-label="Primary">
    {
      navLinks.map((link) => (
        <a
          href={link.url}
          target={link.newTab ? '_blank' : undefined}
          rel={link.newTab ? 'noopener noreferrer' : undefined}
          aria-current={isCurrent(link.url) ? 'page' : undefined}
          class:list={['menu-drawer__link', isCurrent(link.url) && 'is-current']}
          data-menu-link
          data-ga-event={gaEventForNav(link.url)}
        >
          <span class={heading.menuItem}>{link.label}</span>
          <span class="menu-drawer__arrow" aria-hidden="true">→</span>
        </a>
      ))
    }
  </nav>

  <div class:list={['menu-drawer__foot', layout.shell]}>
    {
      socials.length > 0 && (
        <div class="menu-drawer__socials">
          {socials.map((social: { platform?: string; url?: string; icon?: string }) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.platform}
              class="menu-drawer__social"
            >
              <img
                src={social.icon ?? `/icons/${social.platform}.svg`}
                alt=""
                width="28"
                height="28"
              />
            </a>
          ))}
        </div>
      )
    }
    {
      header.orderOnline?.url && (
        <a
          href={header.orderOnline.url}
          target={header.orderOnline.newTab ? '_blank' : undefined}
          rel={header.orderOnline.newTab ? 'noopener noreferrer' : undefined}
          data-ga-event="order_click"
          data-ga-placement="drawer"
          class:list={[btn.secondary, 'menu-drawer__cta']}
        >
          <span>{header.orderOnline.label}</span>
        </a>
      )
    }
    {
      header.reservations?.url && (
        <a
          href={header.reservations.url}
          target={header.reservations.newTab ? '_blank' : undefined}
          rel={header.reservations.newTab ? 'noopener noreferrer' : undefined}
          data-ga-event="reservation_click"
          class:list={[btn.secondaryOutline, 'menu-drawer__cta']}
        >
          <span>
            {header.reservations.label === 'reservations' ? 'Reservations' : header.reservations.label}
          </span>
        </a>
      )
    }
  </div>
</div>

<style>
  /* Desktop inline nav from 1536px — Social has more/longer links than Bakehouse,
     so the 1200px cut-off let Merch sit under the centered logo. */
  .navbar {
    display: flex;
    justify-content: center;
    min-height: var(--nav-height);
  }

  .navbar.is-scrolled {
    background-color: var(--color-charcoal);
  }

  .navbar__bar {
    box-sizing: border-box;
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    min-height: var(--nav-height);
  }

  .navbar__links {
    display: none;
    align-items: stretch;
    align-self: stretch;
    gap: var(--space-24, 24px);
  }

  .navbar__links > a {
    display: flex;
    align-items: center;
  }

  .navbar__toggle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-beige);
    cursor: pointer;
    gap: 6px;
  }

  .navbar__toggle-bar {
    display: block;
    width: 28px;
    height: 2px;
    background: currentColor;
    transition: transform 0.35s ease, opacity 0.35s ease;
  }

  .navbar__actions {
    align-self: stretch;
  }

  .navbar__actions :global(.navbar__cta) {
    /* btn.nav* already hide below 992px; keep them from 992 up even with hamburger */
    position: relative;
    z-index: 30;
  }

  @media (min-width: 1536px) {
    .navbar__links {
      display: flex;
    }

    .navbar__toggle {
      display: none;
    }
  }

  @media (max-width: 1535px) {
    .navbar__bar {
      min-height: var(--nav-height);
      justify-content: flex-end;
    }
  }

  /* Full-screen drawer — Bakehouse layout, Social CTAs */
  .menu-drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    background-color: var(--color-charcoal);
    color: var(--color-beige);
    overflow: hidden;
    overscroll-behavior: contain;
    block-size: 100vh;
    block-size: 100svh;
  }

  .menu-drawer > * {
    flex-shrink: 0;
  }

  .menu-drawer > .menu-drawer__links {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    flex-shrink: 1;
    -webkit-overflow-scrolling: touch;
  }

  .menu-drawer[hidden] {
    display: none;
  }

  .menu-drawer__bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 72px;
    padding-block: var(--space-16, 16px);
  }

  .menu-drawer__close {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 44px;
    height: 44px;
    margin-inline-end: -10px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-beige);
    cursor: pointer;
    position: relative;
  }

  .menu-drawer__close-bar {
    position: absolute;
    right: 10px;
    width: 24px;
    height: 2px;
    background: currentColor;
  }

  .menu-drawer__close-bar:first-child {
    transform: rotate(45deg);
  }

  .menu-drawer__close-bar:last-child {
    transform: rotate(-45deg);
  }

  /* 72px rows keep Order + Reservations on-screen at 375×667 / 100svh. */
  .menu-drawer__links {
    display: flex;
    flex-direction: column;
    padding-block-start: var(--space-8, 8px);
  }

  .menu-drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16, 16px);
    min-height: 72px;
    color: var(--color-beige);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--color-beige) 20%, transparent);
    transition: opacity 0.35s ease;
  }

  .menu-drawer__link:hover,
  .menu-drawer__link.is-current {
    opacity: 0.75;
  }

  .menu-drawer__arrow {
    font-family: var(--font-body);
    font-size: 22px;
    line-height: 1;
    opacity: 0.6;
  }

  .menu-drawer__foot {
    margin-block-start: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-12, 12px);
    padding-block: var(--space-16, 16px) calc(var(--space-16, 16px) + env(safe-area-inset-bottom, 0px));
  }

  .menu-drawer__foot :global(.menu-drawer__cta) {
    display: block;
    width: 100%;
    text-align: center;
  }

  .menu-drawer__socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-24, 24px);
  }

  .menu-drawer__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    opacity: 0.9;
    transition: opacity 0.35s ease;
  }

  .menu-drawer__social:hover {
    opacity: 0.7;
  }

  .menu-drawer__social img {
    display: block;
    width: 28px;
    height: 28px;
  }

  .navbar__toggle[data-quiet-focus]:focus-visible,
  .menu-drawer__close[data-quiet-focus]:focus-visible {
    outline: none;
  }

  @media (min-width: 1536px) {
    .menu-drawer {
      display: none !important;
    }
  }
</style>

<script>
  const navbar = document.querySelector('[data-navbar]')
  if (navbar instanceof HTMLElement && navbar.dataset.navScroll === 'true') {
    const SCROLL_THRESHOLD = 48
    const syncNav = () => {
      if (document.documentElement.style.overflow === 'hidden') return
      navbar.classList.toggle('is-scrolled', window.scrollY > SCROLL_THRESHOLD)
    }
    syncNav()
    window.addEventListener('scroll', syncNav, { passive: true })
  }

  const menu = document.getElementById('menu-drawer')
  const toggle = document.querySelector<HTMLButtonElement>('.navbar__toggle')
  const close = document.querySelector<HTMLButtonElement>('.menu-drawer__close')

  if (menu && toggle && close) {
    const focusQuietly = (element: HTMLElement, quiet: boolean) => {
      if (quiet) {
        element.dataset.quietFocus = ''
        document.addEventListener('keydown', () => delete element.dataset.quietFocus, { once: true })
      }
      element.focus()
    }

    const setOpen = (open: boolean, quiet = false) => {
      delete toggle.dataset.quietFocus
      delete close.dataset.quietFocus

      menu.hidden = !open
      toggle.setAttribute('aria-expanded', String(open))
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
      document.documentElement.style.overflow = open ? 'hidden' : ''

      const lenis = window.lenis
      if (lenis) open ? lenis.stop() : lenis.start()

      if (navbar instanceof HTMLElement && navbar.dataset.navScroll === 'true') {
        navbar.classList.toggle('is-scrolled', open || window.scrollY > 48)
      }

      focusQuietly(open ? close : toggle, quiet)
    }

    toggle.addEventListener('click', (event) => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true'
      setOpen(!isOpen, event.detail > 0)
    })
    close.addEventListener('click', (event) => setOpen(false, event.detail > 0))

    menu.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', (event) => setOpen(false, (event as MouseEvent).detail > 0))
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) setOpen(false)
    })
  }
</script>
