---
/**
 * .newsletter — the full-screen signup overlay on the homepage.
 *
 * Note: the live site ships this markup but the compiled CSS sets
 * `.newsletter { display: none }` with no override anywhere, so it is never
 * visible. It is reproduced here for DOM parity (and so an editor can turn it
 * on later); the form is wired to Mailchimp just like the footer one.
 */
import NewsletterForm from './NewsletterForm.astro'

interface Props {
  settings: any
}
const { settings } = Astro.props
const modal = settings.newsletterModal ?? {}
---

<div class="newsletter fixed inset-0 z-50 hidden h-dvh w-full">
  <div
    class="newsletter-overlay absolute inset-0 grid h-full w-full auto-cols-[1fr] grid-cols-1 grid-rows-[auto] place-items-center gap-4 bg-[#00000080] backdrop-blur-[10px]"
  >
    <div class="newsletter-box max-w-[600px] bg-beige pt-5 pr-[39px] pb-5 pl-10">
      <h2 class="newsletter-heading font-heading">{modal.heading}</h2>
      <p>{modal.text}</p>
      <NewsletterForm newsletter={{ ...settings.footer?.newsletter, ...modal }} variant="modal" />
    </div>
  </div>
</div>
