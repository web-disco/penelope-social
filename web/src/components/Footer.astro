---
/**
 * .footer — newsletter band (green) + the four-column footer grid.
 *
 * `.is-not-home` keeps the mobile bottom padding tight now that the homepage
 * no longer pins an order/reservations bar.
 *
 * Grid placement note: Webflow keyed the footer's column spans to `#w-node-*`
 * IDs. All of them resolve to `span 1 / span 1` (the grid default) except the
 * three paragraphs inside `.hours-wrap`, which span both columns — reproduced
 * below as `col-span-2`.
 */
import { heading, containerFooter, container } from '../lib/ui'
import { imageUrl } from '../lib/image'
import NewsletterForm from './NewsletterForm.astro'
import LineText from './LineText.astro'
import { displayHeading, displayLinkLabel, restaurantCopy } from '../data/copy'

interface Props {
  settings: any
  isHome?: boolean
}
const { settings, isHome = false } = Astro.props

const footer = settings.footer ?? {}
const newsletter = footer.newsletter ?? {}
const menus = footer.menus ?? {}
const hours = footer.hours ?? {}
const contact = footer.contact ?? {}

const logoSrc = imageUrl(footer.logo) || '/penelope-logo-lockup-white.svg'

/* Fixed chrome. These were Sanity fields; they are never meaningfully edited
   and a text field only invites drift — the copyright still read “© 2024”. */
const CREDIT = { prefix: 'Website by', label: 'Web Disco', href: 'https://www.webdisco.digital' }

/* The year is derived, never typed. Toronto, not the build machine: CI builds
   in UTC, which turns over five hours before the restaurant does, so a 31
   December evening deploy would otherwise ship next year's footer. */
const YEAR = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  timeZone: 'America/Toronto',
}).format(new Date())

const copyrightText = `© ${YEAR} Penelope Social`

/* Subtle hover for every footer link, matching the .35s of the buttons around
   it. Not applied to the Google Reviews button, which has its own colour
   hover, nor to the logo, which is a graphic rather than a text link. */
const hover = '[transition:opacity_.35s] hover:opacity-70'

/* .footer-text — 14px/160% beige, 180% line-height at ≤767 */
const footerText = 'footer-text text-beige font-body text-[14px] font-medium leading-[160%] wf-sm:leading-[180%]'
const footerTextHours = footerText.replace('font-medium', 'font-normal')
const footerTextSpan = `footer-text-span text-beige font-normal no-underline ${hover}`
---

<div
  class:list={[
    'footer -z-[1] mt-20 bg-charcoal',
    'is-not-home wf-sm:pb-5',
  ]}
>
  <!-- .footer-newsletter — the green band -->
  <div class="footer-newsletter bg-green">
    <div class={container}>
      <h2 class={heading.light}>{displayHeading(newsletter.heading, 'Stay in the loop')}</h2>
      <div class="footer-newsletter-wrap mx-auto max-w-[650px] text-center">
        <p
          class="is-light newsletter-text mb-[10px] font-body text-[26px] leading-[150%] text-beige wf-sm:text-[24px] wf-xs:text-[18px]"
        >
          {newsletter.text}
        </p>
        <NewsletterForm newsletter={newsletter} />
      </div>
    </div>
  </div>

  <div class={containerFooter}>
    <!-- Columns size to their content and spread with space-between, so the gaps
         between the four blocks are even. Four equal-width tracks made the gaps
         uneven instead: each column's content starts at its own track's left
         edge, so a narrow column (hours) sat close to its neighbour while the
         right-aligned contact column left a wide empty stretch beside it.

         The logo track is capped rather than fixed — a hard 318px starves the
         menus column at ~992px. The contact column still right-aligns, so it
         lands flush with the credit in the copyright row below. -->
    <div
      class="footer-grid grid grid-cols-[minmax(200px,318px)_auto_auto_auto] grid-rows-[auto] justify-between gap-10 wf-md:grid-cols-1 wf-md:justify-normal"
    >
      <!-- logo -->
      <div class="footer-content">
        <a
          href="/"
          aria-current={isHome ? 'page' : undefined}
          class:list={[
            'footer-logo-link w-inline-block wf-md:w-full',
            isHome && 'w--current w-full pb-10',
          ]}
        >
          <img
            src={logoSrc}
            loading="lazy"
            alt={footer.logoAlt ?? 'Penelope Social Logo'}
            class="footer-logo w-full max-w-[75%] wf-md:mx-auto wf-md:mb-10 wf-md:block wf-md:max-w-[50%] wf-md:text-left wf-xs:mb-0 wf-xs:max-w-full"
          />
        </a>
      </div>

      <!-- menus -->
      <div class="footer-content">
        <h4
          class="footer-heading mt-0 mb-[30px] font-body text-[18px] leading-[130%] font-normal text-beige uppercase wf-md:mb-5"
        >
          {displayHeading(menus.heading, 'Menus')}
        </h4>
        <!-- Capped so the blurb wraps inside its column instead of setting the
             column's natural width from its longest line. -->
        <div class={`${footerText} max-w-[300px]`}>
          <a href={menus.blurbUrl ?? '/menus'} class={footerTextSpan}>
            <LineText text={restaurantCopy(menus.blurb)} />
          </a>
        </div>
        <div class="footer-menu-wrap flex flex-col gap-[10px]">
          {
            (menus.links ?? []).map((link: any) => (
              <a
                href={link.url}
                class:list={[
                  'footer-menu-link mb-[3px] inline-block font-body font-medium leading-none text-beige uppercase no-underline',
                  hover,
                ]}
              >
                {displayLinkLabel(link.label)}
              </a>
            ))
          }
        </div>
      </div>

      <!-- hours & location -->
      <div class="footer-content is-hours">
        <h4
          class="footer-heading mt-0 mb-[30px] font-body text-[18px] leading-[130%] font-normal text-beige uppercase wf-md:mb-5"
        >
          {displayHeading(hours.heading, 'Hours & location')}
        </h4>
        <div class="hours-wrap grid auto-cols-[1fr] grid-cols-2 grid-rows-[auto] gap-0 wf-xs:grid-cols-1">
          <p class={`${footerText} is-location col-span-2 mb-0 normal-case`}>
            <strong>{hours.locationLabel}</strong>
            <br />
            <a href={hours.mapUrl} target="_blank" data-ga-event="get_directions" class={footerTextSpan}>
              <LineText text={hours.address} />
            </a>
          </p>
          {
            (hours.blocks ?? []).map((block: any) => (
              <p class={`${footerTextHours} is-hours col-span-2`}>
                <strong>
                  {displayHeading(block.label)}
                  <br />
                </strong>
                {(block.lines ?? []).map((line: string) => (
                  <>
                    {line}
                    <br />
                  </>
                ))}
              </p>
            ))
          }
        </div>
      </div>

      <!-- contact — right-aligned so the column ends flush with the container,
           which is where the “Website by Web Disco” credit below it sits. The
           four columns stay equal width; only the text inside this one moves.
           Reverted below 992px, where the grid collapses to a single column and
           everything reads left-aligned again. -->
      <div class="footer-content text-right wf-md:text-left">
        <h4
          class="footer-heading mt-0 mb-[30px] font-body text-[18px] leading-[130%] font-normal text-beige uppercase wf-md:mb-5"
        >
          {displayHeading(contact.heading, 'Contact')}
        </h4>
        <p class={footerText}>
          P: <a href={`tel:${contact.phoneDigits}`} data-ga-event="click_to_call" class={footerTextSpan}>{contact.phone}</a>
          <br />
          E: <a href={contact.emailHref} class={footerTextSpan}><LineText text={contact.email} /></a>
        </p>
        <div class="footer-socials gap-3">
          <div class={footerText}>{contact.socialsLabel}</div>
          <div class="footer-socials-wrap mt-[5px] flex justify-end gap-3 wf-md:justify-start">
            {
              (contact.socials ?? []).map((social: any) => (
                <a
                  href={social.url}
                  target="_blank"
                  aria-label={social.platform}
                  class={`footer-social-link w-inline-block ${hover}`}
                >
                  <img
                    src={social.icon ?? `/icons/${social.platform}.svg`}
                    loading="lazy"
                    alt=""
                    class="footer-social-icon w-7"
                  />
                </a>
              ))
            }
          </div>
        </div>
        {
          contact.googleReview?.url && (
            <div class="footer-google-review mt-[60px] wf-sm:mt-10">
              <a
                href={contact.googleReview.url}
                target="_blank"
                class="btn secondary is-google-review border-2 border-beige bg-beige px-6 py-[18px] text-center font-body font-medium leading-none text-charcoal uppercase no-underline transition-[background-color,color] duration-[350ms] hover:bg-brand-transparent hover:text-beige wf-md:hidden wf-sm:block wf-xs:w-full"
              >
                {contact.googleReview.label}
              </a>
            </div>
          )
        }
      </div>
    </div>

    <div class="footer-copyright mt-20 flex justify-between">
      <div class="copyright-text font-body text-[12px] text-beige no-underline">{copyrightText}</div>
      <div class="copyright-text font-body text-[12px] text-beige no-underline">
        {CREDIT.prefix}{' '}
        <a
          href={CREDIT.href}
          target="_blank"
          class:list={[
            'copyright-text font-body text-[12px] text-beige no-underline',
            hover,
          ]}>{CREDIT.label}</a
        >
      </div>
    </div>
  </div>
</div>
