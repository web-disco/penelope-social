---
/**
 * Inner-page banner with centred H1 + intro (Bakehouse PageHero).
 * H1 is painted immediately — no GSAP / .reveal hide.
 */
import { heading, layout, typeScale } from '../../lib/ui'
import { imageUrl, imageAlt } from '../../lib/image'

interface Props {
  src?: string
  image?: any
  alt?: string
  headingText?: string
  intro?: string
  objectPosition?: string
  /** Extra classes on the on-photo lede. Desktop stays one line (Bakehouse). */
  introClass?: string
  /** Visible trail above the H1; the last crumb is the current page. */
  breadcrumbs?: { name: string; path: string }[]
}

const {
  src,
  image,
  alt,
  headingText,
  intro,
  objectPosition = 'center',
  introClass,
  breadcrumbs,
} = Astro.props

const imgSrc = src || imageUrl(image)
const imgAlt = alt || imageAlt(image)
const bannerHeight = 'h-[550px] wf-md:h-[420px] wf-sm:h-[440px] wf-xs:h-[400px]'
const hasBreadcrumbs = !!breadcrumbs && breadcrumbs.length > 1
// The section gap sits under whatever closes the banner: the photo, or the breadcrumb bar.
const gapBelow = 'mb-section-gap-y wf-sm:mb-section-gap-y-sm'
---

<div class:list={['page-banner relative w-full overflow-hidden', !hasBreadcrumbs && gapBelow, bannerHeight]}>
  {
    imgSrc && (
      <img
        src={imgSrc}
        alt={imgAlt}
        width="1440"
        height="810"
        loading="eager"
        fetchpriority="high"
        class="page-banner-image absolute inset-0 h-full w-full object-cover"
        style={`object-position: ${objectPosition};`}
      />
    )
  }
  <div class="page-banner-overlay pointer-events-none absolute inset-0 bg-black/35" aria-hidden="true"></div>
  <div
    class="page-banner-scrim pointer-events-none absolute inset-x-0 bottom-0 h-[72%] bg-gradient-to-t from-black/92 via-black/55 to-transparent"
    aria-hidden="true"
  >
  </div>
  {
    (headingText || intro) && (
      <div class="page-banner-copy absolute inset-x-0 bottom-0 z-[2] pb-space-48 pt-space-32 wf-md:pb-space-32 wf-sm:pb-space-24 wf-sm:pt-space-24">
        <div class:list={[layout.shell, 'flex flex-col items-center text-center']}>
          {headingText && (
            <h1 class={`${heading.light} ${typeScale.heroMobile} my-0 max-w-[1080px] text-balance`}>
              {headingText}
            </h1>
          )}
          {intro && (
            <p
              class:list={[
                'mt-space-16 mb-0 max-w-none text-beige not-italic whitespace-nowrap',
                'wf-md:whitespace-normal wf-md:max-w-[720px] wf-md:text-pretty',
                typeScale.intro,
                introClass,
              ]}
            >
              {intro}
            </p>
          )}
        </div>
      </div>
    )
  }
</div>

{
  hasBreadcrumbs && (
    <nav aria-label="Breadcrumb" class:list={['page-breadcrumbs bg-charcoal', gapBelow]}>
      <div class={layout.shell}>
        <ol class:list={['m-0 flex list-none flex-wrap items-center gap-x-space-8 p-0 py-space-16 text-cream/70', typeScale.label]}>
          {breadcrumbs!.map((crumb, i) => (
            <li class="flex items-center gap-x-space-8">
              {i > 0 && <span aria-hidden="true">/</span>}
              {i < breadcrumbs!.length - 1 ? (
                <a
                  href={crumb.path}
                  class="text-cream/70 no-underline transition-opacity duration-[350ms] hover:opacity-70"
                >
                  {crumb.name}
                </a>
              ) : (
                <span aria-current="page" class="text-cream">
                  {crumb.name}
                </span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )
}

<style>
  /* Inner-page heroes: phones ≤600px (and xs) are 32. Desktop/tablet steps unchanged. */
  @media (max-width: 600px) {
    .page-banner h1 {
      font-size: 32px;
      line-height: 1;
    }
  }
</style>
