---
/**
 * Home hero — full-bleed photo with overlay copy.
 * H1 + supporting line + dual CTAs on a bottom-weighted scrim (Bakehouse pattern).
 */
import { btn, heading, layout, typeScale } from '../../lib/ui'
import { imageUrl, imageAlt } from '../../lib/image'
import { homeHeroFallback } from '../../data/home'

interface Props {
  block: any
}
const { block } = Astro.props

/* Repo wins. Sanity `hero.body` is ignored so a stale Studio lede cannot paint. */
const headingText = homeHeroFallback.heading
const bodyText = homeHeroFallback.body
const primaryCta = block.orderOnline
const secondaryCta = block.reservations
---

<div class="section-home-hero relative mb-section-gap-y block h-dvh w-full flex-col wf-sm:mb-section-gap-y-sm">
  <div class="home-hero relative h-full overflow-hidden">
    <img
      src={imageUrl(block.image)}
      loading="eager"
      fetchpriority="high"
      width="1440"
      height="810"
      alt={imageAlt(block.image)}
      class="home-hero-image absolute inset-0 h-full w-full object-cover animate-hero-ken"
    />
    <div class="home-hero-overlay absolute inset-0 h-full w-full bg-black/35"></div>
    <div
      class="home-hero-scrim pointer-events-none absolute inset-x-0 bottom-0 h-[72%] bg-gradient-to-t from-black/92 via-black/55 to-transparent"
    >
    </div>

    <div class="home-hero-copy absolute inset-x-0 bottom-0 z-[1] pt-section-y pb-space-32">
      <div class:list={[layout.shell, 'flex flex-col items-start justify-start text-left']}>
        <h1
          class={`${heading.lightLeft} mb-space-16 max-w-[1080px] text-balance text-left wf-sm:mb-space-12`}
        >
          {headingText}
        </h1>
        {
          bodyText && (
            <p
              class:list={[
                'mb-space-32 max-w-[640px] text-left text-beige text-pretty not-italic',
                typeScale.intro,
                'wf-sm:mb-space-24',
              ]}
            >
              {bodyText}
            </p>
          )
        }
        {
          (primaryCta?.url || secondaryCta?.url) && (
            <div class="intros-cta flex flex-wrap items-start justify-start gap-space-16 wf-xs:w-full wf-xs:flex-col wf-xs:items-stretch">
              {primaryCta?.url && (
                <a
                  href={primaryCta.url}
                  target={primaryCta.newTab ? '_blank' : undefined}
                  rel={primaryCta.newTab ? 'noopener noreferrer' : undefined}
                  data-ga-event="order_click"
                  data-ga-placement="hero"
                  class={btn.onMediaPrimary}
                >
                  <span>{primaryCta.label}</span>
                </a>
              )}
              {secondaryCta?.url && (
                <a
                  href={secondaryCta.url}
                  target={secondaryCta.newTab ? '_blank' : undefined}
                  rel={secondaryCta.newTab ? 'noopener noreferrer' : undefined}
                  data-ga-event="reservation_click"
                  class={btn.secondaryOutline}
                >
                  <span>{secondaryCta.label}</span>
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes hero-ken {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.04);
    }
  }
  .animate-hero-ken {
    animation: hero-ken 18s ease-out forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-hero-ken {
      animation: none;
    }
  }

  /* Bakehouse homepage H1 scale. Cascade 991 → 767 → 600 → 479 so xs stays 36. */
  .section-home-hero h1 {
    font-size: 64px;
    line-height: 1;
  }

  @media (max-width: 991px) {
    .section-home-hero h1 {
      font-size: 56px;
    }
  }

  @media (max-width: 767px) {
    .section-home-hero h1 {
      font-size: 46px;
    }
  }

  @media (max-width: 600px) {
    .section-home-hero h1 {
      font-size: 40px;
    }
  }

  @media (max-width: 479px) {
    .section-home-hero h1 {
      font-size: 36px;
    }
  }
</style>
