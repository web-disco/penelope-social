---
/**
 * .section-intro — centred H1, a max-width intro paragraph and an optional
 * pair of CTA buttons.
 */
import { container, heading, paragraph, btn } from '../../lib/ui'
import LineText from '../LineText.astro'
import { displayHeading, restaurantCopy } from '../../data/copy'

interface Props {
  block: any
  /** Homepage intro sits under the hero H1, so PageBuilder passes h2 there. */
  headingLevel?: 'h1' | 'h2'
}
const { block, headingLevel = 'h1' } = Astro.props
const Heading = headingLevel
const ctas: any[] = block.ctas ?? []
const headingText = displayHeading(block.heading)
const introText = restaurantCopy(block.intro)
---

<div class="section-intro">
  <div class={container}>
    {
      headingText && (
        <Heading class={heading.base}>
          <LineText text={headingText} />
        </Heading>
      )
    }
    {
      introText && (
        <div class="intro-text mx-auto max-w-[1000px]">
          <p class={paragraph.intro}>
            <LineText text={introText} />
          </p>
        </div>
      )
    }
    {
      ctas.length > 0 && (
        <div class="intros-cta mt-10 flex items-center justify-center gap-5 wf-xs:flex-col">
          {ctas.map((cta) => (
            <a
              href={cta.url}
              target={cta.newTab ? '_blank' : undefined}
              data-ga-event={
                cta.url === '/reservations' || String(cta.url).includes('toasttab.com/restaurants')
                  ? 'reservation_click'
                  : undefined
              }
              class={cta.style === 'outline' ? btn.outline : btn.primary}
            >
              <span>{displayHeading(cta.label)}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</div>
