---
/**
 * About timeline — Bakehouse structure, no GSAP hide on the heading.
 */
import { layout, space, heading, typeScale } from '../../lib/ui'

export interface TimelineStep {
  title: string
  body: string
}

interface Props {
  headingText: string
  steps: TimelineStep[]
}

const { headingText, steps } = Astro.props
---

<section class="section-step-timeline" aria-label={headingText}>
  <div class:list={[layout.shell, space.sectionY]}>
    <div class="step-timeline mx-auto w-full max-w-[50em]">
      <div class="step-timeline__header mb-[3em] flex flex-col items-center text-center">
        <h2 class:list={[heading.medium, 'my-0']}>{headingText}</h2>
      </div>

      <div class="step-timeline__wrapper relative mx-auto w-fit max-w-full">
        <div class="step-timeline__line pointer-events-none absolute bottom-0 left-[1.5em] top-0 w-0.5 bg-charcoal/15">
          <div class="step-timeline__fill absolute inset-0 h-full w-full origin-top bg-green"></div>
        </div>

        <div class="step-timeline__collection">
          <div class="step-timeline__list flex flex-col items-stretch gap-[8em] wf-sm:gap-[6em]">
            {
              steps.map((step, i) => (
                <div class="step-timeline__item relative flex items-start gap-[3em] wf-sm:gap-space-24">
                  <div
                    class="step-timeline__marker relative flex size-[3em] shrink-0 items-center justify-center rounded-full border border-green bg-green text-beige font-body font-medium"
                  >
                    <span class={typeScale.label}>{i + 1}</span>
                  </div>
                  <div class="step-timeline__content flex max-w-[36em] flex-col items-start gap-space-16 pt-[0.4em]">
                    <h3 class:list={['step-timeline__content-h my-0 text-charcoal', typeScale.displayS]}>
                      {step.title}
                    </h3>
                    <p class:list={['step-timeline__p mb-0 text-charcoal', typeScale.bodyLg]}>{step.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 767px) {
    .step-timeline {
      max-width: none;
    }
  }
</style>
