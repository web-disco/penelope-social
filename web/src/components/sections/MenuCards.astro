---
/**
 * Menu mosaic — Bakehouse pattern: H2 + 20px intro, 4 tiles
 * (image, 20px title, 18px line). Homepage keeps the outline CTA to /menus.
 * Desktop: 4-up grid. Tablet: Swiper at 2.5 slides. Mobile: Swiper at 1.1,
 * so the next card peeks at every width the slider runs.
 */
import { btn, heading, layout, radius, space, typeScale } from '../../lib/ui'
import { imageUrl, imageSrcset, imageSizes, imageAlt } from '../../lib/image'
import { displayHeading, menuTitle, restaurantCopy } from '../../data/copy'
import { homeMenusFallback } from '../../data/home'
import GoogleRating from '../GoogleRating.astro'

interface Props {
  block: any
}
const { block } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const isHome = path === '/'
const isMenusHub = path === '/menus'
/* The "menus" block on the homepage and the hub is chrome-owned. Any other card
   block, e.g. "What we're known for" on either page, is authored. */
const isChromeBlock = (isHome || isMenusHub) && block._key === 'menus'
/* "sentence": the cards as one large line of type, each a photo pill plus a
   link, with plain words between (block.sentence). Used by the homepage's
   "What we're known for" so it doesn't read as a second copy of the menu row
   above it, or echo the text-and-photo split of "Events" below it. */
const isSentence = block.layout === 'sentence'
const authored: any[] = block.cards ?? []
const fallbackByUrl = new Map(homeMenusFallback.cards.map((card) => [card.url, card]))

const cards = (authored.length ? authored : homeMenusFallback.cards).map((card: any, index: number) => {
  if (!isChromeBlock && !fallbackByUrl.has(card.url)) {
    return { ...card, title: menuTitle(card.title), line: restaurantCopy(card.line) }
  }
  const fallback =
    fallbackByUrl.get(card.url) ?? homeMenusFallback.cards[index] ?? homeMenusFallback.cards[0]
  return {
    ...card,
    title: menuTitle(card.title, fallback.title),
    line: isChromeBlock ? fallback.line : restaurantCopy(card.line, fallback.line),
    url: card.url || fallback.url,
  }
})

const cardByUrl = new Map(cards.map((card: any) => [card.url, card]))
const sentence: any[] = isSentence ? block.sentence ?? [] : []

const staleHeading = /woodbridge|explore our menus|menus at penelope/i.test(block.heading ?? '')
const staleIntro = /woodbridge|hawkview|125\s|bakehouse/i.test(block.intro ?? '')
const sectionHeading = isMenusHub && isChromeBlock
  ? ''
  : (isHome && isChromeBlock) || staleHeading
    ? homeMenusFallback.heading
    : displayHeading(block.heading)
const sectionIntro = isMenusHub && isChromeBlock
  ? ''
  : isHome && isChromeBlock
    ? homeMenusFallback.intro
    : staleIntro
      ? homeMenusFallback.hubIntro
      : restaurantCopy(block.intro)
// Authored hub blocks only show a button when they set one (no self-link to /menus).
const ctaUrl = block.cta?.url || (isChromeBlock ? homeMenusFallback.ctaUrl : undefined)
// Optional Google rating under the intro (homepage "On the menu", /menus "What we're known for").
const hasRating = !!block.rating?.url && !!sectionIntro
const ctaLabel = /view all menus/i.test(block.cta?.label ?? '')
  ? homeMenusFallback.ctaLabel
  : displayHeading(block.cta?.label, homeMenusFallback.ctaLabel)

const tileClass = 'menu-mosaic-tile group flex h-full flex-col no-underline'
// isolate: the clip holds while the image scales (Safari).
const frameClass = `overflow-hidden isolate ${radius.none}`
// Same slow zoom as MenuItemCards, on hover or keyboard focus anywhere on the tile.
// Pre-promoted layer so the zoom doesn't snap or re-blur at either end.
const imageClass =
  'block w-full aspect-[4/5] object-cover transition-transform duration-500 ' +
  'will-change-transform [backface-visibility:hidden] ' +
  'motion-safe:group-hover:scale-[1.03] motion-safe:group-focus-visible:scale-[1.03]'
const labelClass = `mt-space-16 mb-0 text-charcoal ${typeScale.title}`
const lineClass = `mt-space-8 mb-0 text-charcoal/80 ${typeScale.body}`
---

<section id={isChromeBlock ? 'menu' : undefined} class="section-menu-mosaic overflow-x-hidden">
  <div class:list={[layout.shell, isChromeBlock ? space.sectionYFirst : space.sectionY]}>
    {
      sectionHeading && !isSentence && (
        <h2
          class:list={[
            /* The homepage mosaic keeps the large display heading; an authored
               mid-page block (e.g. "What we're known for") uses the section size. */
            isChromeBlock ? heading.base : heading.medium,
            'text-center',
            sectionIntro ? 'mb-0' : 'mb-space-48 wf-sm:mb-space-32',
          ]}
        >
          {sectionHeading}
        </h2>
      )
    }
    {
      sectionIntro && !isSentence && (
        <p
          class:list={[
            'mx-auto mt-space-16 text-center text-charcoal',
            hasRating ? 'mb-0' : 'mb-space-48',
            !hasRating && 'wf-sm:mb-space-32',
            layout.measureNarrow,
            typeScale.intro,
          ]}
        >
          {sectionIntro}
        </p>
      )
    }
    {
      hasRating && (
        <div class="mb-space-48 wf-sm:mb-space-32">
          <GoogleRating rating={block.rating} />
        </div>
      )
    }
    {isSentence ? (
      <div class="flex flex-col items-center gap-space-24 text-center wf-sm:gap-space-16">
        <h2 class:list={['m-0 text-charcoal', typeScale.label]}>{sectionHeading}</h2>
        {/* Inline flow, not flex, so commas sit on their word; each photo stays
            with its link via nowrap. Pills are sized in em to scale with the type. */}
        <p class="specialty-sentence mx-auto my-0 max-w-[1200px] font-body text-[48px] font-medium leading-[1.4] tracking-[-0.01em] text-balance text-charcoal wf-md:text-[36px] wf-sm:text-[28px] wf-xs:text-[24px]">
          {
            sentence.map((part, index) => {
              const gap = index ? ' ' : ''
              const card: any = part.url ? cardByUrl.get(part.url) : undefined
              if (!card) return <>{gap}{part.text ?? part.label}</>
              return (
                <>
                  {gap}
                  <span class="whitespace-nowrap">
                    <a href={card.url} class="group no-underline">
                      <img
                        src={imageUrl(card.image, 240)}
                        loading="lazy"
                        alt=""
                        width="84"
                        height="52"
                        draggable="false"
                        class="mr-[0.28em] inline-block h-[1.08em] w-[1.75em] rounded-full object-cover align-[-0.22em] transition-transform duration-300 motion-safe:group-hover:scale-105 motion-safe:group-focus-visible:scale-105"
                      />
                      <span class="underline decoration-2 underline-offset-[0.16em] transition-colors duration-300 group-hover:text-green group-focus-visible:text-green">{part.label}</span>
                    </a>{part.after}
                  </span>
                </>
              )
            })
          }
        </p>
      </div>
    ) : (
    <div class="swiper menu-mosaic-swiper w-full" data-menu-mosaic-swiper>
      <div class="swiper-wrapper">
        {
          cards.map((card) => (
            <div class="swiper-slide">
              <a href={card.url} class={tileClass}>
                <div class={frameClass}>
                  <img
                    src={imageUrl(card.image)}
                    srcset={imageSrcset(card.image)}
                    sizes={imageSizes(card.image) ?? '(min-width: 992px) 25vw, (min-width: 768px) 40vw, 90vw'}
                    loading="lazy"
                    alt={imageAlt(card.image)}
                    width="800"
                    height="1000"
                    draggable="false"
                    class={imageClass}
                  />
                </div>
                <p class={labelClass}>{card.title}</p>
                {card.line && <p class={lineClass}>{card.line}</p>}
              </a>
            </div>
          ))
        }
      </div>
    </div>
    )}
    {
      ctaUrl && !isMenusHub && (
        <div class="mt-space-48 flex justify-center wf-sm:mt-space-32">
          <a
            href={ctaUrl}
            target={block.cta?.newTab ? '_blank' : undefined}
            class={btn.outline}
          >
            <span>{ctaLabel}</span>
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .menu-mosaic-swiper.swiper {
    overflow: visible;
    width: 100%;
  }

  .menu-mosaic-swiper .swiper-slide {
    height: auto;
  }

  @media (min-width: 992px) {
    .menu-mosaic-swiper.swiper {
      overflow: visible;
      width: 100%;
    }

    :global(.menu-mosaic-swiper .swiper-wrapper) {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
      width: 100%;
      transform: none;
    }

    :global(.menu-mosaic-swiper .swiper-slide) {
      width: 100%;
      margin: 0;
    }
  }
</style>

<script>
  import { initMenuMosaicSwiper } from '../../scripts/menu-mosaic-swiper'
  initMenuMosaicSwiper()
</script>
