---
/**
 * Menu mosaic — Bakehouse pattern: H2 + 20px intro, 4 tiles
 * (image, 20px title, 18px line), then an outline section CTA.
 * Desktop: 4-up. Mobile: Swiper at 1.1 slides so the next card peeks.
 */
import { btn, heading, layout, radius, space, typeScale } from '../../lib/ui'
import { imageUrl, imageSrcset, imageSizes, imageAlt } from '../../lib/image'
import { displayHeading, restaurantCopy } from '../../data/copy'
import { homeMenusFallback } from '../../data/home'

interface Props {
  block: any
}
const { block } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const isHome = path === '/'
const authored: any[] = block.cards ?? []
const fallbackByUrl = new Map(homeMenusFallback.cards.map((card) => [card.url, card]))

const cards = (authored.length ? authored : homeMenusFallback.cards).map((card: any, index: number) => {
  const fallback =
    fallbackByUrl.get(card.url) ?? homeMenusFallback.cards[index] ?? homeMenusFallback.cards[0]
  return {
    ...card,
    title: displayHeading(card.title, fallback.title),
    line: isHome ? fallback.line : restaurantCopy(card.line, fallback.line),
    url: card.url || fallback.url,
  }
})

const staleHeading = /woodbridge|explore our menus/i.test(block.heading ?? '')
const staleIntro = /woodbridge|hawkview|125\s/i.test(block.intro ?? '')
const sectionHeading = isHome || staleHeading
  ? homeMenusFallback.heading
  : displayHeading(block.heading)
const sectionIntro = isHome || staleIntro
  ? homeMenusFallback.intro
  : restaurantCopy(block.intro)
const ctaUrl = block.cta?.url || homeMenusFallback.ctaUrl
const ctaLabel = /view all menus/i.test(block.cta?.label ?? '')
  ? homeMenusFallback.ctaLabel
  : displayHeading(block.cta?.label, homeMenusFallback.ctaLabel)

const tileClass = 'menu-mosaic-tile flex h-full flex-col no-underline'
const frameClass = `overflow-hidden ${radius.none}`
const imageClass = 'block w-full aspect-[4/5] object-cover'
const labelClass = `mt-space-16 mb-0 text-charcoal ${typeScale.title}`
const lineClass = `mt-space-8 mb-0 text-charcoal/80 ${typeScale.body}`
---

<section id="menu" class="section-menu-mosaic overflow-x-hidden">
  <div class:list={[layout.shell, space.sectionYFirst]}>
    {
      sectionHeading && (
        <h2
          class:list={[
            heading.base,
            'text-center',
            sectionIntro ? 'mb-0' : 'mb-space-48 wf-sm:mb-space-32',
          ]}
        >
          {sectionHeading}
        </h2>
      )
    }
    {
      sectionIntro && (
        <p
          class:list={[
            'mx-auto mt-space-16 mb-space-48 text-center text-charcoal',
            'wf-sm:mb-space-32',
            layout.measureNarrow,
            typeScale.intro,
          ]}
        >
          {sectionIntro}
        </p>
      )
    }
    <div class="swiper menu-mosaic-swiper w-full" data-menu-mosaic-swiper>
      <div class="swiper-wrapper">
        {
          cards.map((card) => (
            <div class="swiper-slide">
              <a href={card.url} class={tileClass}>
                <div class={frameClass}>
                  <img
                    src={imageUrl(card.image)}
                    srcset={imageSrcset(card.image)}
                    sizes={imageSizes(card.image) ?? '(min-width: 992px) 25vw, 90vw'}
                    loading="lazy"
                    alt={imageAlt(card.image)}
                    width="800"
                    height="1000"
                    draggable="false"
                    class={imageClass}
                  />
                </div>
                <p class={labelClass}>{card.title}</p>
                {card.line && <p class={lineClass}>{card.line}</p>}
              </a>
            </div>
          ))
        }
      </div>
    </div>
    {
      ctaUrl && (
        <div class="mt-space-48 flex justify-center wf-sm:mt-space-32">
          <a
            href={ctaUrl}
            target={block.cta?.newTab ? '_blank' : undefined}
            class={btn.outline}
          >
            {ctaLabel}
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .menu-mosaic-swiper.swiper {
    overflow: visible;
    width: 100%;
  }

  .menu-mosaic-swiper .swiper-slide {
    height: auto;
  }

  @media (min-width: 992px) {
    .menu-mosaic-swiper.swiper {
      overflow: visible;
      width: 100%;
    }

    :global(.menu-mosaic-swiper .swiper-wrapper) {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
      width: 100%;
      transform: none;
    }

    :global(.menu-mosaic-swiper .swiper-slide) {
      width: 100%;
      margin: 0;
    }
  }
</style>

<script>
  import { initMenuMosaicSwiper } from '../../scripts/menu-mosaic-swiper'
  initMenuMosaicSwiper()
</script>
