---
import { typeScale } from "../../lib/ui";

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = "The merch",
  title = "Take a shirt home from Social",
  body = "Hoodies, tees, and totes. Pick them up in store.",
  ctaLabel = "See merch",
  ctaHref = "/merchandise",
} = Astro.props;
---

<section class="wave-moment" aria-labelledby="wave-moment-title">
  <div class="wave-moment__band">
    <svg
      class="wave-checkers"
      width="100%"
      height="48"
      aria-hidden="true"
      shape-rendering="crispEdges"
    >
      <defs>
        <pattern id="wave-check-in" width="48" height="48" patternUnits="userSpaceOnUse">
          <rect width="24" height="24" fill="#f7f3df" />
          <rect x="24" width="24" height="24" fill="#2e442e" />
          <rect y="24" width="24" height="24" fill="#2e442e" />
          <rect x="24" y="24" width="24" height="24" fill="#f7f3df" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#wave-check-in)" />
    </svg>
    <div class="wave-moment__inner">
      <div class="wave-moment__copy">
        <p class="eyebrow wave-moment__eyebrow">{eyebrow}</p>
        <h2 id="wave-moment-title" class={typeScale.heading}>{title}</h2>
        <p class={typeScale.lede}>{body}</p>
        <a class="button-primary wave-moment__cta" href={ctaHref}>{ctaLabel}</a>
      </div>
      <div class="wave-moment__art">
        <img src="/images/penelope-bike.svg" alt="" class="wave-bike" />
      </div>
    </div>
    <svg
      class="wave-checkers"
      width="100%"
      height="48"
      aria-hidden="true"
      shape-rendering="crispEdges"
    >
      <defs>
        <pattern id="wave-check-out" width="48" height="48" patternUnits="userSpaceOnUse">
          <rect width="24" height="24" fill="#2e442e" />
          <rect x="24" width="24" height="24" fill="#f7f3df" />
          <rect y="24" width="24" height="24" fill="#f7f3df" />
          <rect x="24" y="24" width="24" height="24" fill="#2e442e" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#wave-check-out)" />
    </svg>
  </div>
</section>

<style>
  .wave-moment {
    background: var(--color-cream);
  }

  .wave-moment__band {
    background: #2e442e;
    color: var(--color-cream);
  }

  .wave-checkers {
    display: block;
    width: 100%;
    height: 48px;
  }

  .wave-moment__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 48px 80px 8px;
  }

  .wave-moment__copy {
    max-width: 520px;
    padding-bottom: 40px;
  }

  .wave-moment__eyebrow {
    color: var(--color-cream);
    margin-bottom: 12px;
  }

  .wave-moment__copy h2 {
    color: var(--color-cream);
    margin-bottom: 16px;
  }

  .wave-moment__copy p:not(.eyebrow) {
    color: var(--color-cream);
    margin-bottom: 24px;
  }

  .wave-moment__cta {
    background: var(--color-cream);
    color: var(--color-ink);
  }

  .wave-moment__art {
    flex: 0 0 auto;
    width: min(42vw, 480px);
    align-self: flex-end;
  }

  .wave-bike {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 991px) {
    .wave-moment__inner {
      padding: 40px 40px 0;
    }

    .wave-moment__art {
      width: min(46vw, 360px);
    }
  }

  @media (max-width: 767px) {
    .wave-moment__inner {
      flex-direction: column;
      align-items: stretch;
      padding: 32px 20px 0;
      gap: 16px;
    }

    .wave-moment__copy {
      max-width: none;
      padding-bottom: 8px;
    }

    .wave-moment__art {
      width: min(88vw, 420px);
      margin-left: auto;
    }
  }
</style>
