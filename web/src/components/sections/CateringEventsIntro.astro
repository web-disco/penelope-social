---
import { btn, layout, typeScale } from '../../lib/ui'
import { cateringEventsIntro, cateringMenuLink } from '../../data/catering'
---

<section class="catering-events-lede mb-section-gap-y wf-sm:mb-section-gap-y-sm">
  <div class:list={[layout.shell, 'pt-0 pb-0']}>
    <p
      class:list={[
        'mx-auto mb-0 max-w-[720px] text-center text-charcoal',
        '[&_a]:text-charcoal [&_a]:underline [&_a]:underline-offset-[0.18em] [&_a]:decoration-charcoal/40',
        '[&_a]:transition-opacity [&_a]:duration-[350ms] hover:[&_a]:opacity-70',
        typeScale.bodyLg,
      ]}
      set:html={cateringEventsIntro}
    />
    <div class="mt-space-24 flex justify-center">
      <a href={cateringMenuLink.url} class={btn.outline}>
        <span>{cateringMenuLink.label}</span>
      </a>
    </div>
  </div>
</section>
