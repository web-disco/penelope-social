---
/**
 * Centred lede under the /catering-events banner, with an optional solid
 * button (Request catering) before the catering-menu button.
 */
import { btn, layout, typeScale } from '../../lib/ui'
import { inlineHtml, type SectionOf } from '../../lib/content'
import { isCateringHref } from '../../lib/analytics'

interface Props {
  block: SectionOf<'cateringIntro'>
}
const { block } = Astro.props
const primary = block.primaryCta
/* Off-site (the Google Form) always opens in a new tab, like links in copy. */
const primaryNewTab = primary && (primary.newTab || primary.url.startsWith('https://'))
---

<section class="catering-events-lede mb-section-gap-y wf-sm:mb-section-gap-y-sm">
  <div class:list={[layout.shell, 'pt-0 pb-0']}>
    <p
      class:list={[
        'mx-auto mb-0 max-w-[720px] text-center text-charcoal',
        '[&_a]:text-charcoal [&_a]:underline [&_a]:underline-offset-[0.18em] [&_a]:decoration-charcoal/40',
        '[&_a]:transition-opacity [&_a]:duration-[350ms] hover:[&_a]:opacity-70',
        typeScale.bodyLg,
      ]}
      set:html={inlineHtml(block.body)}
    />
    <div class="mt-space-24 flex flex-wrap justify-center gap-space-16 wf-xs:flex-col">
      {
        primary && (
          <a
            href={primary.url}
            target={primaryNewTab ? '_blank' : undefined}
            rel={primaryNewTab ? 'noopener noreferrer' : undefined}
            data-ga-event={isCateringHref(primary.url) ? 'catering_click' : undefined}
            class={btn.primary}
          >
            <span>{primary.label}</span>
          </a>
        )
      }
      <a href={block.cta.url} class={btn.outline}>
        <span>{block.cta.label}</span>
      </a>
    </div>
  </div>
</section>
