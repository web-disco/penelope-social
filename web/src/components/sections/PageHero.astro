---
/**
 * Inner-page banner. Always paints H1 + lede on the photo
 * (Bakehouse catering style). Never a second cream-section title.
 */
import BannerHero from './BannerHero.astro'
import { imageAlt } from '../../lib/image'
import { bannerCopyFor } from '../../data/banners'

interface Props {
  block: any
  /** The page's trail, shown as a bar under the banner. Same list as its BreadcrumbList. */
  breadcrumbs?: { name: string; path: string }[]
}
const { block, breadcrumbs } = Astro.props

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const copy = bannerCopyFor(path, { heading: block.heading, intro: block.intro })
---

<BannerHero
  image={block.image}
  src={block.src}
  alt={block.alt || imageAlt(block.image)}
  headingText={copy.heading}
  intro={copy.intro}
  objectPosition={block.objectPosition}
  breadcrumbs={breadcrumbs}
/>
