---
/**
 * Inner-page banner. Always paints H1 + lede on the photo
 * (Bakehouse catering style). Never a second cream-section title.
 */
import BannerHero from './BannerHero.astro'
import type { Image } from '../../lib/content'

interface Props {
  block: { image: Image; heading: string; intro: string }
  /** The page's trail, shown as a bar under the banner. Same list as its BreadcrumbList. */
  breadcrumbs?: { name: string; path: string }[]
}
const { block, breadcrumbs } = Astro.props
---

<BannerHero image={block.image} headingText={block.heading} intro={block.intro} breadcrumbs={breadcrumbs} />
