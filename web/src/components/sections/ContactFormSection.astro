---
/**
 * .section-events-form — the two-column enquiry form used on /catering-events
 * and /contact.
 *
 * The `_2-col` field wrappers and `.form-btn-wrap` carried `#w-node-*` grid
 * rules of `span 1 / span 2`, reproduced here as `col-span-2`.
 *
 * Submission now goes to the Cloudflare Worker (`data-endpoint`), which
 * verifies Turnstile and emails the submission on — see web/worker/index.ts.
 */
import { containerNoTop, pageSubHeadingSmall, formField, formFieldTextarea, btn } from '../../lib/ui'
import Turnstile from '../Turnstile.astro'

interface Props {
  block: any
}
const { block } = Astro.props

const isEvents = block.variant === 'events'
const fields: any[] = block.fields ?? []
---

<div class="section-events-form">
  <div class={containerNoTop}>
    <div class="form-block w-form mx-auto mb-0 max-w-[900px] text-center">
      {block.heading && <h2 class={pageSubHeadingSmall}>{block.heading}</h2>}
      {block.intro && <p class="mb-0 mt-space-16 text-charcoal font-body text-[18px] leading-[150%] wf-xs:text-[16px]">{block.intro}</p>}

      <form
        id={isEvents ? 'events-form' : 'contact-form'}
        name={isEvents ? 'Events Form' : 'Contact Form'}
        data-endpoint={isEvents ? '/api/events' : '/api/contact'}
        class="form mt-10 grid auto-cols-[1fr] grid-cols-2 grid-rows-[auto] gap-4"
      >
        {
          fields.map((field) => (
            <div
              class:list={[
                'form-field-wrap',
                field.fullWidth && '_2-col col-span-2',
              ]}
            >
              {field.type === 'select' ? (
                <select
                  id={field.id}
                  name={field.name}
                  required={field.required}
                  class={`${formField} w-select`}
                >
                  <option value="">{field.placeholder}</option>
                  {(field.options ?? []).map((option: string) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
              ) : field.type === 'textarea' ? (
                <textarea
                  id={field.id}
                  name={field.name}
                  maxlength="5000"
                  placeholder={field.placeholder}
                  required={field.required}
                  class={`${formFieldTextarea} textarea w-input`}
                />
              ) : (
                <input
                  class={`${formField} w-input`}
                  maxlength={field.type === 'date' || field.name === 'Date' ? undefined : '256'}
                  name={field.name}
                  placeholder={field.type === 'date' || field.name === 'Date' ? undefined : field.placeholder}
                  aria-label={field.placeholder}
                  type={field.type === 'date' || field.name === 'Date' ? 'date' : (field.type ?? 'text')}
                  id={field.id}
                  required={field.required}
                />
              )}
              {field.note && (
                <div class="form-field-text mb-6 text-left font-body text-[14px] font-normal italic text-charcoal">
                  {field.note}
                </div>
              )}
            </div>
          ))
        }

        {/*
          The Turnstile slot shares this cell rather than taking a grid row of
          its own: the form grid has a 16px `gap-4`, which a separate item would
          cost even while the widget measures 0x0. Column rather than row so the
          challenge appears above the button instead of beside it — with one
          child (the usual case, widget hidden) this renders identically to the
          row it replaces: horizontally centred, bottom-aligned.
        */}
        {
          isEvents && (
            <label class="form-consent col-span-2 mt-2 flex cursor-pointer items-start gap-2 text-left">
              <input
                type="checkbox"
                name="catering-notice"
                value="yes"
                required
                class="consent-checkbox consent-checkbox--on-light"
              />
              <span class="font-body text-[14px] font-normal leading-[18px] text-charcoal">
                I understand catering orders need at least 24 hours' notice.
              </span>
            </label>
          )
        }

        <div class="form-btn-wrap col-span-2 mt-space-24 flex flex-col items-center justify-end">
          <Turnstile class="w-full text-center [&.is-visible]:mb-[20px]" theme="light" />
          <button
            type="submit"
            data-wait="Please wait..."
            class={`${btn.primary} w-button cursor-pointer rounded-none`}
          >
            <span>{block.submitLabel ?? 'Submit'}</span>
          </button>
        </div>
      </form>

      <div class="success-message-3 w-form-done bg-charcoal p-5 text-center font-body text-beige">
        <div>{block.successMessage ?? 'Thank you! Your submission has been received!'}</div>
      </div>
      <div class="w-form-fail mt-[10px] bg-[#ffdede] p-[10px]">
        <div>
          {block.errorMessage ?? 'Oops! Something went wrong while submitting the form.'}
        </div>
      </div>
    </div>
  </div>
</div>
