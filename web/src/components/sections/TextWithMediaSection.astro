---
/**
 * The two-column image/copy sections on the homepage:
 *   .section-home-bread  — image first, copy second
 *   .home-events         — copy first, image second
 *
 * Both collapse to one column at ≤991px. The events variant additionally
 * switches to `display:flex` with `wrap-reverse`, which is what pushes the
 * image above the copy on mobile.
 */
import { container, heading, btn, typeScale } from '../../lib/ui'
import { imageUrl, imageSrcset, imageSizes, imageAlt } from '../../lib/image'
import { displayHeading, restaurantCopy } from '../../data/copy'
import { homeBreadFallback, homeEventsFallback } from '../../data/home'

interface Props {
  block: any
}
const { block } = Astro.props
const imageFirst = block.layout !== 'copy-first'
const fallback = imageFirst ? homeBreadFallback : homeEventsFallback
const looksLikeNap = /hawkview|woodbridge restaurant|125\s/i.test(
  `${block.heading ?? ''} ${block.body ?? ''}`,
)
const headingText =
  imageFirst && looksLikeNap
    ? homeBreadFallback.heading
    : displayHeading(block.heading, fallback.heading)
const bodyText =
  imageFirst && looksLikeNap
    ? homeBreadFallback.body
    : restaurantCopy(block.body, fallback.body)
const ctaUrl = block.cta?.url ?? ('ctaUrl' in fallback ? fallback.ctaUrl : undefined)
const ctaLabel = displayHeading(
  block.cta?.label,
  'ctaLabel' in fallback ? fallback.ctaLabel : undefined,
)

const wrapClass = imageFirst
  ? 'home-bread-wrap grid auto-cols-[1fr] grid-cols-2 grid-rows-[auto] gap-[60px] wf-md:grid-cols-1 wf-md:gap-[30px]'
  : 'home-events-wrap grid auto-cols-[1fr] grid-cols-2 grid-rows-[auto] gap-[60px] wf-md:flex wf-md:flex-wrap-reverse wf-md:grid-cols-1 wf-md:gap-[30px]'

const imageClass = imageFirst
  ? 'home-bread-image aspect-square w-full object-cover wf-md:max-h-[600px] wf-sm:max-h-[500px] wf-xs:max-h-[300px]'
  : 'home-events-image aspect-square w-full object-cover wf-md:max-h-[600px] wf-sm:max-h-[500px] wf-xs:max-h-[300px]'

const contentClass = imageFirst
  ? 'home-bread-content story-copy flex flex-col items-start justify-center gap-space-24'
  : 'home-events-content story-copy flex flex-col items-start justify-center gap-space-24'
---

<div class={imageFirst ? 'section-home-bread' : 'home-events'}>
  <div class={container}>
    <div class={wrapClass}>
      {
        imageFirst && (
          <img
            src={imageUrl(block.image)}
            loading="eager"
            sizes={imageSizes(block.image)}
            srcset={imageSrcset(block.image)}
            alt={imageAlt(block.image)}
            class={imageClass}
          />
        )
      }

      <div class={contentClass}>
        <div>
          <h2 class:list={[heading.medium, 'text-left my-0']}>{headingText}</h2>
          <p class:list={['mt-space-16 mb-0 text-charcoal max-w-[720px]', typeScale.body]}>{bodyText}</p>
        </div>
        {
          ctaUrl && (
            <div class={imageFirst ? 'home-bread-cta' : 'events-cta'}>
              <a
                href={ctaUrl}
                target={block.cta?.newTab ? '_blank' : undefined}
                data-ga-event={ctaUrl === '/catering-events' ? 'catering_click' : undefined}
                class={block.cta?.style === 'outline' ? btn.outline : btn.primary}
              >
                {ctaLabel}
              </a>
            </div>
          )
        }
      </div>

      {
        !imageFirst && (
          <img
            src={imageUrl(block.image)}
            loading="eager"
            sizes={imageSizes(block.image)}
            srcset={imageSrcset(block.image)}
            alt={imageAlt(block.image)}
            class={imageClass}
          />
        )
      }
    </div>
  </div>
</div>
