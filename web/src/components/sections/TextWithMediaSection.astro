---
/**
 * The two-column image/copy sections on the homepage:
 *   .section-home-bread  — image first, copy second
 *   .home-events         — copy first, image second
 *
 * Bakehouse story-grid: 12 columns, media 7, copy 5 bottom-aligned.
 * Events puts the image first on mobile (wf-md:order).
 */
import { container, heading, btn, typeScale, story } from '../../lib/ui'
import { inlineHtml, type SectionOf } from '../../lib/content'
import ResponsivePicture from '../ResponsivePicture.astro'

interface Props {
  block: SectionOf<'textWithMedia'>
}
const { block } = Astro.props
const imageFirst = block.layout !== 'copy-first'
const headingText = block.heading
/* Copy with a link gets link styling; plain copy renders as plain text. */
const bodyHtml = /\]\(/.test(block.body) ? inlineHtml(block.body) : undefined
const bodyText = block.body
const ctaUrl = block.cta?.url
const ctaLabel = block.cta?.label
const ctaNewTab = Boolean(block.cta?.newTab)
const ctaStyle = block.cta?.style

const mediaOrder = imageFirst ? '' : 'wf-md:order-1'
const copyOrder = imageFirst ? '' : 'wf-md:order-2'
---

<div class={imageFirst ? 'section-home-bread' : 'home-events'}>
  <div class={container}>
    <div class={story.grid}>
      {
        imageFirst && (
          <div class={story.media}>
            <ResponsivePicture
              image={block.image}
              sizes="(min-width: 992px) 58vw, 100vw"
              loading="eager"
              imgClass={story.image}
            />
          </div>
        )
      }

      <div class:list={[story.copy, copyOrder]}>
        <div>
          <h2 class:list={[heading.medium, 'text-left my-0']}>{headingText}</h2>
          {bodyHtml ? (
            <p
              class:list={[
                'mt-space-16 mb-0 text-charcoal',
                '[&_a]:text-charcoal [&_a]:underline [&_a]:underline-offset-[0.18em] [&_a]:decoration-charcoal/40',
                '[&_a]:transition-opacity [&_a]:duration-[350ms] hover:[&_a]:opacity-70',
                typeScale.bodyLg,
              ]}
              set:html={bodyHtml}
            />
          ) : (
            <p class:list={['mt-space-16 mb-0 text-charcoal', typeScale.bodyLg]}>{bodyText}</p>
          )}
        </div>
        {
          ctaUrl && (
            <div class="story-cta">
              <a
                href={ctaUrl}
                target={ctaNewTab ? '_blank' : undefined}
                rel={ctaNewTab ? 'noopener noreferrer' : undefined}
                data-ga-event={ctaUrl === '/catering-events' ? 'catering_click' : undefined}
                class:list={['inline-block', ctaStyle === 'outline' ? btn.outline : btn.primary]}
              >
                <span>{ctaLabel}</span>
              </a>
            </div>
          )
        }
      </div>

      {
        !imageFirst && (
          <div class:list={[story.media, mediaOrder]}>
            <ResponsivePicture
              image={block.image}
              sizes="(min-width: 992px) 58vw, 100vw"
              loading="eager"
              imgClass={story.image}
            />
          </div>
        )
      }
    </div>
  </div>
</div>
