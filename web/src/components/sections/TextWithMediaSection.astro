---
/**
 * The two-column image/copy sections on the homepage:
 *   .section-home-bread  — image first, copy second
 *   .home-events         — copy first, image second
 *
 * Bakehouse story-grid: 12 columns, media 7, copy 5 bottom-aligned.
 * Events puts the image first on mobile (wf-md:order).
 */
import { container, heading, btn, typeScale, story } from '../../lib/ui'
import { imageUrl, imageSrcset, imageSizes, imageAlt } from '../../lib/image'
import { displayHeading } from '../../data/copy'
import { homeBreadFallback, homeEventsFallback } from '../../data/home'

interface Props {
  block: any
}
const { block } = Astro.props
const imageFirst = block.layout !== 'copy-first'
const fallback = imageFirst ? homeBreadFallback : homeEventsFallback
const headingText = fallback.heading
const bodyText = fallback.body
const ctaUrl = imageFirst ? homeBreadFallback.ctaUrl : (block.cta?.url ?? ('ctaUrl' in fallback ? fallback.ctaUrl : undefined))
const ctaLabel = imageFirst
  ? homeBreadFallback.ctaLabel
  : displayHeading(block.cta?.label, 'ctaLabel' in fallback ? fallback.ctaLabel : undefined)
const ctaNewTab = imageFirst || Boolean(block.cta?.newTab)
const ctaStyle = imageFirst ? 'outline' : block.cta?.style

const mediaOrder = imageFirst ? '' : 'wf-md:order-1'
const copyOrder = imageFirst ? '' : 'wf-md:order-2'
---

<div class={imageFirst ? 'section-home-bread' : 'home-events'}>
  <div class={container}>
    <div class={story.grid}>
      {
        imageFirst && (
          <div class={story.media}>
            <img
              src={imageUrl(block.image)}
              loading="eager"
              sizes={imageSizes(block.image)}
              srcset={imageSrcset(block.image)}
              alt={imageAlt(block.image)}
              class={story.image}
            />
          </div>
        )
      }

      <div class:list={[story.copy, copyOrder]}>
        <div>
          <h2 class:list={[heading.medium, 'text-left my-0']}>{headingText}</h2>
          <p class:list={['mt-space-16 mb-0 text-charcoal', typeScale.bodyLg]}>{bodyText}</p>
        </div>
        {
          ctaUrl && (
            <div class="story-cta">
              <a
                href={ctaUrl}
                target={ctaNewTab ? '_blank' : undefined}
                rel={ctaNewTab ? 'noopener noreferrer' : undefined}
                data-ga-event={ctaUrl === '/catering-events' ? 'catering_click' : undefined}
                class:list={['inline-block', ctaStyle === 'outline' ? btn.outline : btn.primary]}
              >
                <span>{ctaLabel}</span>
              </a>
            </div>
          )
        }
      </div>

      {
        !imageFirst && (
          <div class:list={[story.media, mediaOrder]}>
            <img
              src={imageUrl(block.image)}
              loading="eager"
              sizes={imageSizes(block.image)}
              srcset={imageSrcset(block.image)}
              alt={imageAlt(block.image)}
              class={story.image}
            />
          </div>
        )
      }
    </div>
  </div>
</div>
