---
/**
 * .page-heading — heading + intro paragraph, with two variants:
 *   default  — full width, left-aligned wrap
 *   is-center — capped at 900px and centred (bakery, merch)
 * No category jump-link pills. Menu pages put title + lede on the photo.
 */
import { container, heading, paragraph } from '../../lib/ui'
import LineText from '../LineText.astro'
import { displayHeading, restaurantCopy } from '../../data/copy'

interface Props {
  block: any
}
const { block } = Astro.props

const isCenter = block.variant === 'center'
const isLeft = block.align === 'left'
const headingText = displayHeading(block.heading)
const introText = restaurantCopy(block.intro)
---

<div class:list={['page-heading mx-auto', isCenter && 'is-center max-w-[900px]']}>
  <div class={container}>
    <div class="page-heading-wrap mx-auto text-left">
      <h1 class={isLeft ? heading.left : heading.base}>
        <LineText text={headingText} />
      </h1>
      {
        introText && (
          <p class={isLeft ? paragraph.introLeft : paragraph.intro}>
            <LineText text={introText} />
          </p>
        )
      }
    </div>
  </div>
</div>
