---
/**
 * .section-team-grid — three square portraits with name + role.
 * No fade-in hide — first paint stays visible.
 */
import { containerNoTop } from '../../lib/ui'
import { imageUrl, imageAlt } from '../../lib/image'

interface Props {
  block: any
}
const { block } = Astro.props
const members: any[] = block.members ?? []
---

<div class="section-team-grid">
  <div class={containerNoTop}>
    <div
      class="team-grid grid auto-cols-[1fr] grid-cols-3 grid-rows-[auto] gap-[60px] wf-md:grid-cols-1"
    >
      {
        members.map((member) => (
          <div class="team-card">
            <img
              src={imageUrl(member.image)}
              loading="lazy"
              alt={imageAlt(member.image)}
              class="team-image static aspect-square w-full object-cover"
            />
            <h2 class="team-title mb-[10px] font-heading text-charcoal">
              {member.name}
            </h2>
            <div class="team-text font-body text-[24px]">
              {member.role}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
