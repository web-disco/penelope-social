---
/**
 * .section-home-hero — full-viewport image with a dark overlay and the
 * order/reservations bar pinned to the bottom.
 *
 * `.home-hero-reservation` is `display:none` until ≤767px, where the bar goes
 * `position:fixed` and the two links split the width 50/50.
 */
import { imageUrl, imageAlt } from '../../lib/image'

interface Props {
  block: any
}
const { block } = Astro.props
---

<div
  class="section-home-hero relative mb-20 block h-dvh w-full flex-col wf-md:mb-[60px] wf-sm:mb-0"
>
  <div class="home-hero relative h-full overflow-hidden">
    <img
      src={imageUrl(block.image)}
      loading="lazy"
      width="960"
      alt={imageAlt(block.image)}
      class="home-hero-image h-[102%] w-full object-cover wf-md:block"
    />
    <div class="home-hero-overlay absolute inset-0 h-full w-full bg-black opacity-40"></div>
  </div>

  <div
    class="home-hero-cta absolute inset-x-0 top-auto -bottom-px h-[60px] w-full wf-sm:fixed wf-sm:z-10 wf-sm:flex"
  >
    <a
      href={block.orderOnline?.url}
      target="_blank"
      class="home-hero-menu w-inline-block flex h-full w-full items-center justify-center border-2 border-charcoal bg-charcoal font-body leading-4 text-beige uppercase no-underline wf-sm:w-1/2"
    >
      <div class="home-hero-menu-text text-[16px] leading-none font-medium wf-sm:text-[14px]">
        {block.orderOnline?.label}
      </div>
    </a>
    <a
      href={block.reservations?.url}
      target="_blank"
      class="home-hero-reservation w-inline-block hidden wf-sm:flex wf-sm:h-full wf-sm:w-1/2 wf-sm:items-center wf-sm:justify-center wf-sm:border-t-2 wf-sm:border-x-0 wf-sm:border-b-0 wf-sm:border-solid wf-sm:border-t-charcoal wf-sm:bg-beige wf-sm:no-underline"
    >
      <div
        class="home-hero-reservation-text wf-sm:font-body wf-sm:font-medium wf-sm:leading-none wf-sm:text-charcoal wf-sm:uppercase"
      >
        {block.reservations?.label}
      </div>
    </a>
  </div>
</div>
