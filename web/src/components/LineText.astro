---
/**
 * Renders a string with newlines as `<br />`, matching the hard line breaks
 * Webflow's headings carried (e.g. "Sourdough Bakery\n& Restaurant").
 */
interface Props {
  text?: string
}
const { text = '' } = Astro.props
const lines = text.split('\n')
---

{
  lines.map((line, index) => (
    <>
      {line}
      {index < lines.length - 1 && <br />}
    </>
  ))
}
