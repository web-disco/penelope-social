---
/**
 * Maps a YAML section's `type` to its component.
 *
 * The rule that keeps this scalable: a new section on the site = one schema in
 * src/lib/content-schema.ts (added to `section`) + one component in
 * `sections/` + one entry in this map.
 */
import Hero from './sections/Hero.astro'
import PageHero from './sections/PageHero.astro'
import MenuCards from './sections/MenuCards.astro'
import TextWithMediaSection from './sections/TextWithMediaSection.astro'
import WaveMoment from './sections/WaveMoment.astro'
import MerchListing from './sections/MerchListing.astro'
import ContactFormSection from './sections/ContactFormSection.astro'
import CateringEventsIntro from './sections/CateringEventsIntro.astro'
import FaqSection from './sections/FaqSection.astro'
import StepTimeline from './sections/StepTimeline.astro'
import RichTextIntro from './sections/RichTextIntro.astro'
import MenuItemCards from './sections/MenuItemCards.astro'
import MediaTextCta from './sections/MediaTextCta.astro'
import ComparisonTable from './sections/ComparisonTable.astro'
import FinalCta from './sections/FinalCta.astro'
import VisitDetails from './sections/VisitDetails.astro'
import { paragraphsHtml, type Section } from '../lib/content'

const COMPONENTS: Record<Section['type'], any> = {
  hero: Hero,
  pageHero: PageHero,
  menuCards: MenuCards,
  textWithMedia: TextWithMediaSection,
  waveMoment: WaveMoment,
  merchListing: MerchListing,
  contactForm: ContactFormSection,
  cateringIntro: CateringEventsIntro,
  richTextIntro: RichTextIntro,
  menuItemCards: MenuItemCards,
  mediaTextCta: MediaTextCta,
  comparisonTable: ComparisonTable,
  visitDetails: VisitDetails,
  finalCta: FinalCta,
  faqSection: FaqSection,
  stepTimeline: StepTimeline,
}

interface Props {
  sections: Section[]
  /** Breadcrumb trail for the page hero's bar. */
  breadcrumbs?: { name: string; path: string }[]
}
const { sections = [], breadcrumbs } = Astro.props
---

{
  sections.map((block) => {
    const Component = COMPONENTS[block.type]
    if (block.type === 'pageHero') {
      return <Component block={block} breadcrumbs={breadcrumbs} />
    }
    if (block.type === 'faqSection') {
      return <FaqSection headingText={block.heading} markdownItems={block.items} />
    }
    if (block.type === 'stepTimeline') {
      return (
        <StepTimeline
          headingText={block.heading}
          steps={block.steps.map((step) => ({ title: step.title, bodyHtml: paragraphsHtml(step.body) }))}
        />
      )
    }
    return <Component block={block} />
  })
}
