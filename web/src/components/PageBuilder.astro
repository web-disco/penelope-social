---
/**
 * Maps a page-builder section's `_type` to its component.
 *
 * The rule that keeps this scalable: a new section on the site = one schema in
 * studio/schemaTypes/sections/ + one entry in studio/schemaTypes/objects/pageBuilder.ts
 * + one component in `sections/` + one entry in this map.
 */
import Hero from './sections/Hero.astro'
import PageHero from './sections/PageHero.astro'
import IntroSection from './sections/IntroSection.astro'
import PageHeading from './sections/PageHeading.astro'
import MenuCards from './sections/MenuCards.astro'
import TextWithMediaSection from './sections/TextWithMediaSection.astro'
import TeamGrid from './sections/TeamGrid.astro'
import StorySection from './sections/StorySection.astro'
import MerchListing from './sections/MerchListing.astro'
import ContactFormSection from './sections/ContactFormSection.astro'
import ImageGrid from './sections/ImageGrid.astro'
import FaqSection from './sections/FaqSection.astro'
import StepTimeline from './sections/StepTimeline.astro'

const COMPONENTS: Record<string, any> = {
  hero: Hero,
  pageHero: PageHero,
  introSection: IntroSection,
  pageHeading: PageHeading,
  menuCards: MenuCards,
  textWithMediaSection: TextWithMediaSection,
  teamGrid: TeamGrid,
  storySection: StorySection,
  merchListing: MerchListing,
  contactFormSection: ContactFormSection,
  imageGrid: ImageGrid,
  faqSection: FaqSection,
  stepTimeline: StepTimeline,
}

interface Props {
  sections: any[]
}
const { sections = [] } = Astro.props
---

{
  sections.map((block) => {
    const Component = COMPONENTS[block._type]
    if (!Component) {
      console.warn(`[PageBuilder] no component registered for section type "${block._type}"`)
      return null
    }
    /* Homepage hero is the H1. The old “Cafe and bar in Woodbridge” intro is gone. */
    if (block._type === 'introSection' && sections.some((section) => section._type === 'hero')) {
      return null
    }
    /* /menus is one H2 + lede + tiles. Drop the extra cream pageHeading. */
    if (
      block._type === 'pageHeading' &&
      Astro.url.pathname.replace(/\/$/, '') === '/menus'
    ) {
      return null
    }
    /* Catering (and any page hero with an on-image H1) should not repeat that title. */
    if (block._type === 'introSection') {
      const pageHero = sections.find((section) => section._type === 'pageHero')
      const heroHasTitle =
        Boolean(pageHero?.heading) || Astro.url.pathname.replace(/\/$/, '') === '/catering-events'
      if (heroHasTitle) {
        return <Component block={{ ...block, heading: '' }} headingLevel="h2" />
      }
    }
    if (block._type === 'faqSection') {
      return <FaqSection headingText={block.heading} items={block.items ?? []} />
    }
    if (block._type === 'stepTimeline') {
      return <StepTimeline headingText={block.heading} steps={block.steps ?? []} />
    }
    return <Component block={block} />
  })
}
