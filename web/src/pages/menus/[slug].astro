---
/**
 * /menus/lunch, /menus/dinner, /menus/bar, /menus/catering
 * /menus/catering is the tray list — not a thin copy of /catering-events.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/sections/PageHero.astro'
import PageHeading from '../../components/sections/PageHeading.astro'
import MenuCategories from '../../components/MenuCategories.astro'
import FaqSection from '../../components/sections/FaqSection.astro'
import { getAll } from '../../lib/data'
import { resolveSeo } from '../../data/seo'
import { restaurantCopy, displayHeading } from '../../data/copy'
import { cateringMenuCopy } from '../../data/menus'
import { cateringMenuFaq } from '../../data/faq'
import { SITE_ORIGIN } from '../../data/site'
import { btn, layout, space, typeScale, heading } from '../../lib/ui'
import {
  bakehouseSchema,
  breadcrumbSchema,
  faqPageSchema,
  menuSchema,
  pageGraph,
  restaurantSchema,
} from '../../lib/schema'

export async function getStaticPaths() {
  const menus = await getAll<any>('menu')
  return menus
    .filter((menu) => menu.slug?.current)
    .map((menu) => ({ params: { slug: menu.slug.current }, props: { menu } }))
}

const { menu } = Astro.props
const slug = menu.slug.current as string
const path = `/menus/${slug}`
const isCateringMenu = slug === 'catering'
const seo = resolveSeo(path, menu.seo)
const headingText = isCateringMenu
  ? cateringMenuCopy.heading
  : displayHeading(menu.heading, menu.title)
const introText = isCateringMenu ? cateringMenuCopy.intro : restaurantCopy(menu.intro)

const menuSections = (menu.categories ?? [])
  .map((category: any) => ({
    name: category.title,
    description: category.description,
    items: (category.items ?? [])
      .filter((item: any) => item.title && !/unavailable/i.test(item.title))
      .map((item: any) => ({
        name: item.title,
        description: item.description,
        price: item.price,
      })),
  }))
  .filter((section: { items: unknown[] }) => section.items.length > 0)

const graph = pageGraph([
  restaurantSchema(),
  bakehouseSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Menus', path: '/menus' },
    { name: headingText, path },
  ]),
  menuSchema({
    name: headingText,
    path,
    description: seo.description,
    sections: menuSections,
  }),
  ...(isCateringMenu ? [faqPageSchema(cateringMenuFaq)] : []),
])

const quickLinks = (menu.categories ?? [])
  .filter((category: any) => category.anchor?.current)
  .map((category: any) => ({ label: category.title, anchor: category.anchor.current }))

const canonical = `${SITE_ORIGIN}${path}`
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={menu.seo?.ogImage}
  noIndex={menu.seo?.noIndex}
  canonical={canonical}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph)} />
  <PageHero block={{ image: menu.banner }} />
  <PageHeading
    block={{
      heading: headingText,
      intro: introText,
      align: 'left',
      quickLinks,
    }}
  />
  {
    isCateringMenu && (
      <section class="catering-menu-note">
        <div class:list={[layout.shell, space.sectionYFirst, 'flex flex-col items-start gap-space-24']}>
          <h2 class:list={[heading.medium, 'text-left my-0']}>{cateringMenuCopy.noteHeading}</h2>
          <p class:list={['mb-0 max-w-[720px] text-charcoal', typeScale.bodyLg]}>
            {cateringMenuCopy.noteBody}
          </p>
          <a href={cateringMenuCopy.cta.url} data-ga-event="catering_click" class={btn.primary}>
            {cateringMenuCopy.cta.label}
          </a>
        </div>
      </section>
    )
  }
  <MenuCategories categories={menu.categories ?? []} />
  {isCateringMenu && <FaqSection headingText="FAQs" items={cateringMenuFaq} includeSchema={false} />}
</BaseLayout>
