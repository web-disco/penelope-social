---
/**
 * /menus/lunch, /menus/dinner, /menus/bar, /menus/catering, plus any extra
 * menu (Happy Hour) that is reached from a callout rather than the four cards.
 * /menus/catering is the tray list — not a thin copy of /catering-events.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/sections/PageHero.astro'
import MenuCategories from '../../components/MenuCategories.astro'
import MenuCallout from '../../components/sections/MenuCallout.astro'
import { calloutsFor, menuCategories, menus, offersFor, plainText, type Menu } from '../../lib/content'
import { SITE_ORIGIN } from '../../data/site'
import { btn, layout, space, typeScale, heading } from '../../lib/ui'
import {
  bakehouseSchema,
  breadcrumbSchema,
  menuSchema,
  pageGraph,
  restaurantSchema,
} from '../../lib/schema'

export async function getStaticPaths() {
  return menus.map((menu) => ({ params: { slug: menu.slug }, props: { menu } }))
}

const { menu } = Astro.props as { menu: Menu }
const slug = menu.slug
const path = `/menus/${slug}`
const seo = menu.seo
const categories = menuCategories(menu)
const offers = offersFor(menu)
const callouts = calloutsFor(menu)

const menuSections = categories
  .map((category) => ({
    name: category.title,
    description: plainText(category.description),
    items: category.items.map((item) => ({ name: item.title, description: item.description, price: item.price })),
  }))
  .filter((section) => section.items.length > 0)

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Menus', path: '/menus' },
  // Short names, so the trail reads Lunch / Dinner / Bar / Catering whatever the H1 says.
  { name: menu.breadcrumb, path },
]

const graph = pageGraph([
  restaurantSchema(),
  bakehouseSchema(),
  breadcrumbSchema(breadcrumbs),
  menuSchema({
    name: menu.heading,
    path,
    description: seo.description,
    sections: menuSections,
  }),
])

const canonical = `${SITE_ORIGIN}${path}`
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noIndex={seo.noIndex}
  canonical={canonical}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph)} />
  {/* The banner's objectPosition steers the crop; without one it stays centred. */}
  <PageHero block={{ image: menu.banner, heading: menu.heading, intro: menu.intro }} breadcrumbs={breadcrumbs} />
  {
    menu.note && (
      <section class="catering-menu-note">
        <div class:list={[layout.shell, space.sectionYFirst, 'flex flex-col items-start gap-space-24']}>
          <h2 class:list={[heading.medium, 'text-left my-0']}>{menu.note.heading}</h2>
          <p class:list={['mb-0 max-w-[720px] text-charcoal', typeScale.bodyLg]}>
            {menu.note.body}
          </p>
          <a href={menu.note.cta.url} data-ga-event="catering_click" class={btn.primary}>
            <span>{menu.note.cta.label}</span>
          </a>
        </div>
      </section>
    )
  }
  <MenuCategories categories={categories} flushTop={!menu.note} offers={offers} />
  {
    callouts.length > 0 && (
      <div class:list={[layout.shell, 'pb-section-gap-y wf-sm:pb-section-gap-y-sm']}>
        {callouts.map((featured) => <MenuCallout menu={featured} />)}
      </div>
    )
  }
</BaseLayout>
