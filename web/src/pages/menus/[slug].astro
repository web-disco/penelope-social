---
/**
 * /menus/lunch, /menus/dinner, /menus/bar, /menus/catering
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/sections/PageHero.astro'
import PageHeading from '../../components/sections/PageHeading.astro'
import MenuCategories from '../../components/MenuCategories.astro'
import { getAll } from '../../lib/data'

export async function getStaticPaths() {
  const menus = await getAll<any>('menu')
  return menus
    .filter((menu) => menu.slug?.current)
    .map((menu) => ({ params: { slug: menu.slug.current }, props: { menu } }))
}

const { menu } = Astro.props
const seo = menu.seo ?? {}

/* The quick-link buttons are derived from the categories rather than authored
   beside them. They were a parallel array in Sanity that repeated each
   category's label and anchor — identical in all four menus, and one rename
   away from pointing at a section that no longer existed. */
const quickLinks = (menu.categories ?? [])
  .filter((category: any) => category.anchor?.current)
  .map((category: any) => ({ label: category.title, anchor: category.anchor.current }))
---

<BaseLayout
  title={seo.metaTitle ?? menu.title}
  description={seo.metaDescription}
  ogImage={seo.ogImage}
  noIndex={seo.noIndex}
>
  <PageHero block={{ image: menu.banner }} />
  <PageHeading
    block={{
      heading: menu.heading,
      intro: menu.intro,
      align: 'left',
      quickLinks,
    }}
  />
  <MenuCategories categories={menu.categories ?? []} />
</BaseLayout>
