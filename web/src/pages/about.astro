---
/**
 * About — Bakehouse structure (hero, copy, timeline, video, FAQ).
 * Restaurant-first family story. Take-home bread lives on /bakery-vaughan.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import BannerHero from '../components/sections/BannerHero.astro'
import StepTimeline from '../components/sections/StepTimeline.astro'
import FaqSection from '../components/sections/FaqSection.astro'
import { layout, space, typeScale, heading, btn } from '../lib/ui'
import { about, faqs, inlineHtml } from '../lib/content'
import { bakehouseSchema, breadcrumbSchema, faqPageSchema, pageGraph, restaurantSchema } from '../lib/schema'

const aboutFaq = faqs.about
const video = about.video
const videoCtas = video.ctas
/* Paragraphs, separated by a blank line in about.yaml. */
const paragraphs = about.body.split(/\n\s*\n/).map((p) => inlineHtml(p.replace(/\s*\n\s*/g, ' ').trim()))

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
]

const graph = pageGraph([
  restaurantSchema(),
  bakehouseSchema(),
  faqPageSchema(aboutFaq),
  breadcrumbSchema(breadcrumbs),
])
---

<BaseLayout title={about.seo.title} description={about.seo.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph)} />
  <main>
    <BannerHero
      image={about.banner.image}
      headingText={about.banner.heading}
      intro={about.banner.intro}
      breadcrumbs={breadcrumbs}
    />

    <section class="about-content">
      <div class:list={[layout.shell, 'pt-0 pb-0', 'flex flex-col gap-space-24']}>
        {
          paragraphs.map((p) => (
            <p
              class:list={[
                'mx-auto mb-0 max-w-[720px] text-center text-charcoal',
                '[&_a]:text-charcoal [&_a]:underline [&_a]:underline-offset-[0.18em] [&_a]:decoration-charcoal/40',
                '[&_a]:transition-opacity [&_a]:duration-[350ms] hover:[&_a]:opacity-70',
                typeScale.bodyLg,
              ]}
              set:html={p}
            />
          ))
        }
      </div>
    </section>

    <StepTimeline
      headingText={about.timeline.heading}
      steps={about.timeline.steps}
      gapTop
    />

    <section class="section-story">
      <div class:list={[layout.shell, space.sectionY]}>
        <div
          class="story-grid mx-auto flex w-full max-w-[800px] flex-row items-center gap-x-space-32 wf-md:flex-col wf-md:gap-x-0 wf-md:gap-y-space-24"
        >
          <div class="story-media overflow-hidden rounded-none w-full max-w-[360px] shrink-0 wf-md:mx-auto">
            <video
              class="story-image story-video block h-full w-full object-cover"
              src={video.file}
              poster={video.poster}
              controls
              playsinline
              muted
              loop
              autoplay
              preload="metadata"
              aria-label={video.alt}
              style="aspect-ratio: 9/16; object-position: center center;"
            ></video>
          </div>
          <div class="story-copy flex min-w-0 flex-1 flex-col items-start justify-center gap-space-24 pb-0">
            <div>
              <h2 class:list={[heading.medium, 'text-left my-0']}>{video.heading}</h2>
              <p class:list={['mt-space-16 mb-0 text-charcoal', layout.measureNarrow, typeScale.bodyLg]}>
                {video.body}
              </p>
            </div>
            {
              videoCtas.length > 0 && (
                <div class="story-cta flex flex-wrap items-center gap-space-16">
                  {videoCtas.map((cta) => (
                    <a
                      href={cta.url}
                      target={cta.newTab ? '_blank' : undefined}
                      rel={cta.newTab ? 'noopener noreferrer' : undefined}
                      class:list={['inline-block', cta.style === 'outline' ? btn.outline : btn.primary]}
                    >
                      <span>{cta.label}</span>
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <FaqSection headingText="FAQs" items={aboutFaq} includeSchema={false} />
  </main>
</BaseLayout>
