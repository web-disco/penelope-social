---
/**
 * About — Bakehouse structure (hero, copy, timeline, video, team, FAQ).
 * Restaurant-first. Holds the Vince / origin story. /sourdough-bakery 301s here.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import BannerHero from '../components/sections/BannerHero.astro'
import StepTimeline from '../components/sections/StepTimeline.astro'
import FaqSection from '../components/sections/FaqSection.astro'
import TeamGrid from '../components/sections/TeamGrid.astro'
import { layout, space, typeScale, heading, btn } from '../lib/ui'
import { aboutMeta, aboutPage } from '../data/about'
import { aboutFaq } from '../data/faq'
import { bakehouseSchema, breadcrumbSchema, faqPageSchema, pageGraph, restaurantSchema } from '../lib/schema'
import { getOne } from '../lib/data'

const cmsAbout = await getOne<any>('page', 'about')
const teamBlock = (cmsAbout?.sections ?? []).find((section: any) => section._type === 'teamGrid')
const video = aboutPage.videoTeaser

const graph = pageGraph([
  restaurantSchema(),
  bakehouseSchema(),
  faqPageSchema(aboutFaq),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]),
])
---

<BaseLayout title={aboutMeta.title} description={aboutMeta.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph)} />
  <main>
    <BannerHero
      src={aboutPage.banner.src}
      alt={aboutPage.banner.alt}
      headingText={aboutPage.heading}
      intro={aboutPage.subheading}
      objectPosition="center 50%"
    />

    <section class="about-content">
      <div class:list={[layout.shell, space.sectionYFirst, 'flex flex-col gap-space-24']}>
        {
          aboutPage.paragraphs.map((p) => (
            <p class={`mx-auto mb-0 max-w-[720px] text-center text-charcoal ${typeScale.bodyLg}`}>{p}</p>
          ))
        }
      </div>
    </section>

    <StepTimeline headingText={aboutPage.timeline.heading} steps={aboutPage.timeline.steps} />

    <section class="section-story">
      <div class:list={[layout.shell, 'py-space-32 wf-sm:py-space-24']}>
        <div class="story-grid mx-auto flex w-full max-w-[800px] flex-row items-center gap-x-space-32 wf-md:flex-col wf-md:gap-x-0 wf-md:gap-y-space-24">
          <div class="story-media w-full max-w-[360px] shrink-0 overflow-hidden wf-md:mx-auto">
            <video
              class="story-image story-video block h-full w-full object-cover"
              src={video.video.src}
              controls
              playsinline
              muted
              loop
              autoplay
              preload="metadata"
              aria-label={video.image.alt}
              style={`aspect-ratio: ${video.image.aspect};`}
            ></video>
          </div>
          <div class="story-copy flex min-w-0 flex-1 flex-col items-start justify-center gap-space-24">
            <div>
              <h2 class:list={[heading.medium, 'text-left my-0']}>{video.heading}</h2>
              <p class:list={['mt-space-16 mb-0 text-charcoal max-w-[720px]', typeScale.bodyLg]}>
                {video.body}
              </p>
            </div>
            {
              video.ctas[0] && (
                <a
                  href={video.ctas[0].url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={btn.primary}
                >
                  <span>{video.ctas[0].label}</span>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </section>

    {teamBlock && <TeamGrid block={teamBlock} />}

    <FaqSection headingText="FAQs" items={aboutFaq} includeSchema={false} />
  </main>
</BaseLayout>
