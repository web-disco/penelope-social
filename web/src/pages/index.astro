---
/**
 * The front page reads the `homepage` singleton, not a `page` with the slug
 * "home", so there is no way to end up with two of them — and no way to delete
 * the one there is.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import PageBuilder from '../components/PageBuilder.astro'
import WaveMoment from '../components/sections/WaveMoment.astro'
import FaqSection from '../components/sections/FaqSection.astro'
import { getSingleton, missingContentMessage } from '../lib/data'
import { resolveSeo } from '../data/seo'
import { homeFaq } from '../data/faq'
import { bakehouseSchema, breadcrumbSchema, faqPageSchema, pageGraph, restaurantSchema } from '../lib/schema'

const home = await getSingleton<any>('homepage')
if (!home) throw new Error(missingContentMessage('homepage'))
const seo = resolveSeo('/', home.seo)

const graph = pageGraph([
  restaurantSchema(),
  bakehouseSchema(),
  faqPageSchema(homeFaq),
  breadcrumbSchema([{ name: 'Home', path: '/' }]),
])
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={home.seo?.ogImage}
  noIndex={home.seo?.noIndex}
  isHome
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph)} />
  <PageBuilder sections={home.sections ?? []} />
  <WaveMoment />
  <FaqSection headingText="FAQs" items={homeFaq} includeSchema={false} />
</BaseLayout>
