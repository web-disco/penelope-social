---
/**
 * Pages built from src/content/pages/<slug>.yaml: /contact, /catering-events,
 * /merchandise, /menus and the dish landing pages. /about and /locations/* are
 * their own .astro pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import PageBuilder from '../components/PageBuilder.astro'
import FaqSection from '../components/sections/FaqSection.astro'
import { SITE_ORIGIN, faqs, getMenu, imageSrc, pages, plainText, type Page, type SectionOf } from '../lib/content'
import {
  bakehouseSchema,
  breadcrumbSchema,
  faqPageSchema,
  menuSchema,
  pageGraph,
  restaurantSchema,
  webPageSchema,
} from '../lib/schema'

export async function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }))
}

const { page } = Astro.props as { page: Page }
const slug = page.slug
const path = `/${slug}`
const seo = page.seo

/* A page that closes on the green final-CTA band already ends on its own call
   to action; a second green newsletter band straight after it reads as a repeat. */
const endsWithFinalCta = page.sections.at(-1)?.type === 'finalCta'

/* Shared FAQ sets from faqs.yaml. */
const faqItems = slug === 'contact' ? faqs.contact : slug === 'catering-events' ? faqs.catering : null

/*
 * Landing pages that sell dishes get a Menu node built from the live menu
 * categories, so the prices in the JSON-LD are the ones on /menus/*.
 */
let landingMenu: ReturnType<typeof menuSchema> | null = null
if (page.schemaMenu) {
  const sections = page.schemaMenu
    .map(({ menu, category: anchor, name }) => {
      const category = getMenu(menu)!.categories.find((c) => c.anchor === anchor)!
      return {
        name,
        description: plainText(category.description) || undefined,
        items: category.items.flatMap((item) =>
          'title' in item ? [{ name: item.title, description: item.description, price: item.price }] : [],
        ),
      }
    })
    .filter((section) => section.items.length > 0)
  if (sections.length) landingMenu = menuSchema({ name: page.title, path, description: seo.description, sections })
}

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: page.breadcrumb, path },
]

const heroImage = page.sections.find((block): block is SectionOf<'pageHero'> => block.type === 'pageHero')?.image
const heroImageUrl = heroImage ? new URL(await imageSrc(heroImage, 1920), SITE_ORIGIN).href : undefined

const graph = pageGraph([
  restaurantSchema(),
  bakehouseSchema(),
  ...(page.schemaMenu
    ? [
        webPageSchema({
          path,
          name: seo.title,
          description: seo.description,
          image: heroImageUrl,
          mainEntityId: landingMenu ? `${SITE_ORIGIN.replace(/\/$/, '')}${path}#menu` : undefined,
        }),
      ]
    : []),
  ...(landingMenu ? [landingMenu] : []),
  breadcrumbSchema(breadcrumbs),
  ...(faqItems ? [faqPageSchema(faqItems)] : []),
])
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noIndex={seo.noIndex}
  hideNewsletter={endsWithFinalCta}
>
  {graph && <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph)} />}
  <PageBuilder sections={page.sections} breadcrumbs={breadcrumbs} />
  {faqItems && <FaqSection items={faqItems} includeSchema={false} />}
</BaseLayout>
