---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BannerHero from '../../components/sections/BannerHero.astro'
import LocationDetails from '../../components/sections/LocationDetails.astro'
import FaqSection from '../../components/sections/FaqSection.astro'
import { cafeHours, barHours, faqs, inlineHtml, links, locations, nap } from '../../lib/content'
import { bakehouseSchema, breadcrumbSchema, faqPageSchema, pageGraph, restaurantSchema } from '../../lib/schema'

const page = locations.woodbridge
const woodbridgeFaq = faqs.woodbridge

const detailRows = [
  ...cafeHours.map((block) => ({
    label: block.label,
    lines: block.lines,
  })),
  ...barHours.map((block) => ({
    label: block.label,
    lines: block.lines,
  })),
  {
    label: 'Address',
    lines: [nap.address],
    href: nap.mapUrl,
    external: true,
  },
  {
    label: 'Phone',
    lines: [nap.phone],
    href: `tel:${nap.phoneDigits}`,
  },
  {
    label: 'Email',
    lines: [nap.email],
    href: `mailto:${nap.email}`,
  },
  {
    label: 'Social',
    lines: ['Instagram'],
    href: links.instagram!,
    external: true,
  },
]

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Locations', path: '/locations' },
  { name: 'Woodbridge', path: '/locations/woodbridge' },
]

const graph = pageGraph([
  restaurantSchema(),
  bakehouseSchema(),
  faqPageSchema(woodbridgeFaq),
  breadcrumbSchema(breadcrumbs),
])
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph)} />
  <main>
    <BannerHero image={page.image} headingText={page.heading} intro={page.intro} breadcrumbs={breadcrumbs} />

    <LocationDetails
      headingText={page.details.heading}
      intro={page.details.body}
      introHtml={/\]\(/.test(page.details.body) ? inlineHtml(page.details.body) : undefined}
      ctas={page.details.ctas}
      rows={detailRows}
      mapQuery={nap.mapQuery}
      mapTitle="Map to Penelope Social Woodbridge"
    />

    <FaqSection items={woodbridgeFaq} includeSchema={false} />
  </main>
</BaseLayout>
