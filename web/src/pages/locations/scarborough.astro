---
/**
 * Sister Bakehouse page. Link out to penelopebakehouse.com.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import BannerHero from '../../components/sections/BannerHero.astro'
import LocationDetails from '../../components/sections/LocationDetails.astro'
import FaqSection from '../../components/sections/FaqSection.astro'
import { bakehouse, faqs, inlineHtml, locations } from '../../lib/content'
import { bakehouseSchema, breadcrumbSchema, faqPageSchema, pageGraph, restaurantSchema } from '../../lib/schema'

const page = locations.scarborough
const scarboroughFaq = faqs.scarborough

const detailRows = [
  {
    label: 'Hours',
    lines: bakehouse.hours.flatMap((block) => block.lines),
  },
  {
    label: 'Address',
    lines: [bakehouse.address],
    href: bakehouse.mapUrl,
    external: true,
  },
  {
    label: 'Phone',
    lines: [bakehouse.phone],
    href: `tel:${bakehouse.phoneDigits}`,
  },
  {
    label: 'Email',
    lines: [bakehouse.email],
    href: `mailto:${bakehouse.email}`,
  },
  {
    label: 'Website',
    lines: ['penelopebakehouse.com'],
    href: bakehouse.url,
    external: true,
  },
]

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Locations', path: '/locations' },
  { name: 'Scarborough', path: '/locations/scarborough' },
]

const graph = pageGraph([
  restaurantSchema(),
  bakehouseSchema({ full: true }),
  faqPageSchema(scarboroughFaq),
  breadcrumbSchema(breadcrumbs),
])
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph)} />
  <main>
    <BannerHero image={page.image} headingText={page.heading} intro={page.intro} breadcrumbs={breadcrumbs} />

    <LocationDetails
      headingText={page.details.heading}
      intro={page.details.body}
      introHtml={/\]\(/.test(page.details.body) ? inlineHtml(page.details.body) : undefined}
      ctas={page.details.ctas}
      rows={detailRows}
      mapQuery={bakehouse.mapQuery}
      mapTitle="Map to Penelope Bakehouse Scarborough"
    />

    <FaqSection items={scarboroughFaq} includeSchema={false} />
  </main>
</BaseLayout>
