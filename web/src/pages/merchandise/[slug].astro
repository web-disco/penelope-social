---
/**
 * .section-merch-details — sticky copy column beside a gallery of product
 * shots. Each image opens the lightbox.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/sections/PageHero.astro'
import ResponsivePicture from '../../components/ResponsivePicture.astro'
import { getPage, imageSrc, merch, type Merch, type SectionOf } from '../../lib/content'
import { breadcrumbSchema, pageGraph, restaurantSchema } from '../../lib/schema'
import { container, btn, typeScale } from '../../lib/ui'

export async function getStaticPaths() {
  return merch.map((product) => ({ params: { slug: product.slug }, props: { product } }))
}

const { product } = Astro.props as { product: Merch }
const path = `/merchandise/${product.slug}`
const seo = product.seo
const price = 'merch-details-price mt-0 mb-0 font-heading text-[32px] text-charcoal wf-md:text-[38px] wf-sm:text-[28px] wf-xs:flex-none wf-xs:text-[22px]'
const productName = product.heading
/* Same on-photo heading and lede as /merchandise, over this product's banner. */
const hub = getPage('merchandise')?.sections.find((block): block is SectionOf<'pageHero'> => block.type === 'pageHero')
const images = await Promise.all(product.images.map(async (image) => ({ image, full: await imageSrc(image) })))
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Merch', path: '/merchandise' },
  { name: productName, path },
]
const graph = pageGraph([restaurantSchema(), breadcrumbSchema(breadcrumbs)])
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noIndex={seo.noIndex}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph)} />
  <PageHero
    block={{ image: product.banner, heading: hub?.heading ?? 'Merch', intro: hub?.intro ?? '' }}
    breadcrumbs={breadcrumbs}
  />

  <div class="section-merch-details">
    <div class={container}>
      <div
        class="merch-details grid auto-cols-[1fr] grid-cols-2 grid-rows-[auto] gap-10 wf-md:grid-cols-1"
      >
        <div class="merch-details-images-wrap w-dyn-list">
          <div
            role="list"
            class="merch-details-images-list grid auto-cols-[1fr] grid-cols-1 grid-rows-[auto] gap-4 wf-md:grid-cols-2 wf-sm:grid-cols-2"
          >
            {
              images.map(({ image, full }) => (
                <div role="listitem" class="merch-details-images-item w-dyn-item">
                  <a
                    href={full}
                    data-gallery={`merch-${product.slug}`}
                    class="merch-lightbox glightbox group block w-full overflow-hidden isolate"
                  >
                    <ResponsivePicture
                      image={image}
                      sizes="(min-width: 992px) 50vw, 50vw"
                      imgClass="merch-image block w-full transition-transform duration-500 will-change-transform [backface-visibility:hidden] motion-safe:group-hover:scale-[1.03] motion-safe:group-focus-visible:scale-[1.03]"
                    />
                  </a>
                </div>
              ))
            }
          </div>
        </div>

        <div class="merch-details-content">
          <div class="merch-details-content-wrap sticky top-[150px]">
            <h2
              class:list={[
                'merch-details-title mt-0 mb-space-16 text-left text-charcoal',
                typeScale.displayL,
              ]}
            >
              {productName}
            </h2>
            <div class="merch-details-price-wrap flex pb-5">
              <p class={price}>$</p>
              <p class={price}>{product.price}</p>
            </div>
            <p class:list={['mb-0 text-charcoal', typeScale.body]}>
              {product.description}
            </p>
            {
              product.cta?.url && (
                <div class="merch-details-link mt-10">
                  <a
                    href={product.cta.url}
                    target={product.cta.newTab ? '_blank' : undefined}
                    data-ga-event="merch_click"
                    class={product.cta.style === 'outline' ? btn.outline : btn.primary}
                  >
                    <span>{product.cta.label}</span>
                  </a>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
