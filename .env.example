# ---------------------------------------------------------------------------
# Sanity
# ---------------------------------------------------------------------------
# Create the project with `pnpm dlx sanity@latest init` (or in sanity.io/manage),
# then fill these in. Until PUBLIC_SANITY_PROJECT_ID is set the site builds from
# scripts/output/*.json, so nothing is blocked on this.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Editor token with write access — only needed to run the real content import
# (`pnpm migrate`). Never commit it.
SANITY_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Forms (Cloudflare Worker)
# ---------------------------------------------------------------------------
# Turnstile replaces the captcha Webflow provided. Leave both blank to skip
# verification — forms still work, they just aren't bot-protected.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where contact/events submissions are emailed. resend | cloudflare | (unset)
EMAIL_PROVIDER=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=info@penelopesocial.com
NOTIFY_EMAIL_FROM=
