# ---------------------------------------------------------------------------
# Sanity
# ---------------------------------------------------------------------------
# Symlink this file into both workspaces — the Sanity CLI and Astro each resolve
# env from their own directory, not the repo root:
#   ln -sfn ../.env studio/.env && ln -sfn ../.env web/.env
# Without that, Astro reads no env at all and the Sanity CLI cannot resolve a
# project id ("Invalid studio config format").
SANITY_STUDIO_PROJECT_ID=wlwg9juj
SANITY_STUDIO_DATASET=production

# The front end defaults to project wlwg9juj in code (see DEFAULT_PROJECT_ID in
# web/src/lib/data.ts), so this is only needed to override it. The empty/absent
# distinction is load-bearing:
#   line absent   -> use the default project, i.e. read from Sanity
#   set to empty  -> force the file-fallback layer (scripts/output/*.json)
# Keep it empty until `pnpm migrate` has populated the dataset; after that,
# delete the line so a misconfigured build fails loudly instead of quietly
# deploying the committed fixtures.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Editor token with write access — only needed to run the real content import
# (`pnpm migrate`). Never commit it.
SANITY_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Forms (Cloudflare Worker)
# ---------------------------------------------------------------------------
# Turnstile replaces the captcha Webflow provided. Leave both blank to skip
# verification — forms still work, they just aren't bot-protected.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where contact/events submissions are emailed.
#   postmark | cloudflare | resend | (unset, nobody is emailed)
# NOTIFY_EMAIL_TO is comma-separated; every address gets a copy.
# NOTIFY_EMAIL_FROM must be an address the provider has verified.
EMAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=info@penelopesocial.com,penelopesocial23@gmail.com
NOTIFY_EMAIL_FROM=website@penelopesocial.com
