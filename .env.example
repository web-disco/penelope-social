# ---------------------------------------------------------------------------
# Content lives in web/src/content/*.yaml. The site reads nothing from Sanity.
# The legacy Studio in studio/ still needs these two to run locally:
# ---------------------------------------------------------------------------
SANITY_STUDIO_PROJECT_ID=wlwg9juj
SANITY_STUDIO_DATASET=production

# ---------------------------------------------------------------------------
# Forms (Cloudflare Worker)
# ---------------------------------------------------------------------------
# Turnstile replaces the captcha Webflow provided. Blank skips verification —
# the forms still work, they just aren't bot-protected.
#
# PUBLIC_TURNSTILE_SITE_KEY must be *present*, even if empty: it is baked into
# the HTML at build time, and an absent one fails the build on purpose. A blank
# value is a choice; a missing one is a mistake that ships pages whose forms the
# Worker then rejects. See web/src/lib/turnstile.ts.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where contact/events submissions are emailed.
#   postmark | cloudflare | resend | (unset, nobody is emailed)
# NOTIFY_EMAIL_TO is comma-separated; every address gets a copy.
# NOTIFY_EMAIL_FROM must be an address the provider has verified.
EMAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=info@penelopesocial.com,penelopesocial23@gmail.com
NOTIFY_EMAIL_FROM=website@penelopesocial.com
